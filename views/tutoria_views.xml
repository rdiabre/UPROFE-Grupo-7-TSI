<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VISTA FORM -->
    <record id="view_tutoria_form" model="ir.ui.view">
        <field name="name">uprofe.tutoria.form</field>
        <field name="model">uprofe.tutoria</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="sUsuProfesor"/>
                            <field name="sUsuAlumno"/>
                            <!-- <field name="alumno_id"/> -->
                        </group>
                        <group>
                            <field name="dFecha"/>
                            <field name="bTelematico"/>
                            <field name="bAsiste"/>
                        </group>
                    </group>
                    <group string="Asignación de Horario">
                        <field name="horario_tutoria_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VISTA LIST -->
    <record id="view_tutoria_list" model="ir.ui.view">
        <field name="name">uprofe.tutoria.list</field>
        <field name="model">uprofe.tutoria</field>
        <field name="arch" type="xml">
            <list>
                <field name="dFecha"/>
                <field name="dFecha"/>
                <field name="fHoraIni" widget="float_time"/>
                <field name="fHoraFin" widget="float_time"/>
                <field name="sUsuProfesor"/>
                <field name="sUsuProfesor"/>
                <field name="sUsuAlumno"/>
                <field name="bTelematico"/>
                <field name="bAsiste"/>
                <!-- <field name="alumno_id"/> -->
            </list>
        </field>
    </record>

    <!-- VISTA KANBAN -->
    <record id="view_tutoria_kanban" model="ir.ui.view">
        <field name="name">uprofe.tutoria.kanban</field>
        <field name="model">uprofe.tutoria</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="sUsuProfesor"/>
                <field name="sUsuAlumno"/>
                <field name="dFecha"/>
                <field name="bTelematico"/>
                <field name="bAsiste"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="sUsuProfesor"/> - <field name="sUsuAlumno"/></strong>
                            <div>Fecha: <field name="dFecha"/></div>
                            <div>
                                Telemática: <field name="bTelematico" widget="boolean"/> | 
                                Asiste: <field name="bAsiste" widget="boolean"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="action_uprofe_tutoria" model="ir.actions.act_window">
        <field name="name">Citas de Tutoría</field>
        <field name="res_model">uprofe.tutoria</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
