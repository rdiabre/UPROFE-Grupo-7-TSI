<?xml version="1.0" encoding="utf-8"?>
<!-- Autor: Isabel Cherino -->
<odoo>

    <!-- Lista -->
    <record id="view_uprofe_universidad_destino_list" model="ir.ui.view">
        <field name="name">uprofe.universidad_destino.list</field>
        <field name="model">uprofe.universidad_destino</field>
        <field name="arch" type="xml">
            <list>
                <field name="cod_erasmus"/>
                <field name="sName"/>
                <field name="ciudad_id"/>
                <field name="pais_id"/>
                <field name="idioma_ids" widget="many2many_tags"/>
                <field name="iNum_plazas"/>
                <field name="fCreditos_ofertados" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Formulario -->
    <record id="view_uprofe_universidad_destino_form" model="ir.ui.view">
        <field name="name">uprofe.universidad_destino.form</field>
        <field name="model">uprofe.universidad_destino</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_plazas" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                            <field name="iNum_plazas" widget="statinfo" string="Plazas"/>
                        </button>
                    </div>
                    <field name="bLogo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="sName"/>
                        <h1><field name="sName" placeholder="Por ejemplo, Università di Bologna"/></h1>
                    </div>
                    <group>
                        <group string="Datos generales">
                            <field name="cod_erasmus" placeholder="I BOLOGNA01"/>
                            <field name="idioma_ids" widget="many2many_tags"/>
                            <field name="sWeb" widget="url"/>
                            <field name="sEmail_contacto" widget="email"/>
                        </group>
                        <group string="Ubicación">
                            <field name="ciudad_id"/>
                            <field name="pais_id"/>
                        </group>
                        <group string="Oferta">
                            <field name="iNum_asignaturas"/>
                            <field name="fCreditos_ofertados"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Descomentar cuando convenio tenga el campo universidad_id -->
                        <!-- <page string="Convenios">
                            <field name="convenio_ids"/>
                        </page> -->
                        <page string="Plazas">
                            <field name="plaza_ids">
                                <list>
                                    <field name="cod_plaza"/>
                                    <field name="nivel_estudios_id"/>
                                    <field name="idioma_id"/>
                                    <field name="iDuracion_meses"/>
                                    <field name="iNum_vacantes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Asignaturas">
                            <field name="asignatura_ids">
                                <list>
                                    <field name="cod_asig_destino"/>
                                    <field name="sName"/>
                                    <field name="idioma_id"/>
                                    <field name="fCreditos_ects"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Graph: créditos ofertados por país -->
    <record id="view_uprofe_universidad_destino_graph" model="ir.ui.view">
        <field name="name">uprofe.universidad_destino.graph</field>
        <field name="model">uprofe.universidad_destino</field>
        <field name="arch" type="xml">
            <graph string="Créditos ofertados por país" type="bar">
                <field name="pais_id"/>
                <field name="fCreditos_ofertados" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Kanban (cards): la universidad no tiene fechas, así que en lugar de Calendar se muestran tarjetas -->
    <record id="view_uprofe_universidad_destino_kanban" model="ir.ui.view">
        <field name="name">uprofe.universidad_destino.kanban</field>
        <field name="model">uprofe.universidad_destino</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="sName" class="fw-bold fs-5"/>
                        <field name="cod_erasmus" class="text-muted"/>
                        <div><field name="ciudad_id"/></div>
                        <field name="idioma_ids" widget="many2many_tags"/>
                        <div><field name="iNum_plazas"/> plazas · <field name="iNum_asignaturas"/> asignaturas</div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Búsqueda y filtros -->
    <record id="view_uprofe_universidad_destino_search" model="ir.ui.view">
        <field name="name">uprofe.universidad_destino.search</field>
        <field name="model">uprofe.universidad_destino</field>
        <field name="arch" type="xml">
            <search>
                <field name="sName"/>
                <field name="cod_erasmus"/>
                <field name="ciudad_id"/>
                <field name="pais_id"/>
                <field name="idioma_ids"/>
                <filter string="Con plazas" name="con_plazas" domain="[('iNum_plazas', '&gt;', 0)]"/>
                <filter string="Sin plazas" name="sin_plazas" domain="[('iNum_plazas', '=', 0)]"/>
                <separator/>
                <filter string="Docencia en inglés" name="ingles" domain="[('idioma_ids.sCodigo', '=', 'en')]"/>
                <group string="Agrupar por">
                    <filter string="País" name="group_pais" context="{'group_by': 'pais_id'}"/>
                    <filter string="Ciudad" name="group_ciudad" context="{'group_by': 'ciudad_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_uprofe_universidad_destino" model="ir.actions.act_window">
        <field name="name">Universidades de destino</field>
        <field name="res_model">uprofe.universidad_destino</field>
        <field name="view_mode">list,form,kanban,graph</field>
    </record>

</odoo>
