<odoo>
    <record id="view_ubicacion_list" model="ir.ui.view">
        <field name="name">uprofe.ubicacion.list</field>
        <field name="model">uprofe.ubicacion</field>
        <field name="arch" type="xml">
            <list>
                <field name="sCod_ubicacion" />
                <field name="fLatitud" />
                <field name="fLongitud" />
            </list>
        </field>
    </record>

    <record id="view_ubicacion_form" model="ir.ui.view">
        <field name="name">uprofe.ubicacion.form</field>
        <field name="model">uprofe.ubicacion</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="sCod_ubicacion" string="Código de ubicación" />
                    </group>
                    <group>
                        <field name="fLatitud" string="Latitud" />
                        <field name="fLongitud" string="Longitud" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ubicacion_list_action" model="ir.actions.act_window">
        <field name="name">Ubicaciones</field>
        <field name="res_model">uprofe.ubicacion</field>
        <field name="view_mode">list,form</field>
        <!-- <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea la primera ubicación</p>
        </field> -->
    </record>
</odoo>