<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="uprofe.PanelErasmus">
        <div class="o_action o_uprofe_panel h-100 overflow-auto">
            <div class="o_uprofe_panel_cabecera">
                <div>
                    <h2>Panel Erasmus</h2>
                    <span class="o_uprofe_panel_sub">Resumen de las movilidades de la UPO</span>
                </div>
                <button class="btn btn-primary" t-on-click="actualizar" t-att-disabled="state.cargando">
                    <i t-attf-class="fa fa-refresh {{ state.cargando ? 'fa-spin' : '' }}"/> Actualizar
                </button>
            </div>

            <div t-if="state.cargando and !state.datos" class="o_uprofe_panel_cargando">
                <i class="fa fa-spinner fa-spin fa-2x"/> Cargando datos…
            </div>
            <div t-elif="!state.datos" class="o_uprofe_panel_cargando">No hay datos que mostrar.</div>
            <t t-else="">
                <!-- KPI: componente hijo TarjetaKpi -->
                <div class="o_uprofe_panel_kpis">
                    <t t-foreach="state.datos.kpis" t-as="kpi" t-key="kpi.clave">
                        <TarjetaKpi titulo="kpi.titulo" valor="kpi.valor" icono="kpi.icono" color="kpi.color"
                                    onClick="() => this.abrirKpi(kpi)"/>
                    </t>
                </div>

                <!-- Gráficos: componente hijo GraficoBarras -->
                <div class="o_uprofe_panel_graficos">
                    <GraficoBarras titulo="'Movilidades por estado'" datos="state.datos.por_estado"
                                   unidad="'movilidades'" onSeleccion="(estado) => this.abrirEstado(estado)"/>
                    <GraficoBarras titulo="'Vacantes por país'" datos="state.datos.por_pais"
                                   unidad="'vacantes'" onSeleccion="(pais) => this.abrirPais(pais)"/>
                </div>

                <!-- Movilidades en curso y próximas, con buscador reactivo -->
                <div class="o_uprofe_panel_tabla">
                    <div class="o_uprofe_panel_tabla_cabecera">
                        <h4>Movilidades en curso y próximas</h4>
                        <div class="o_uprofe_panel_filtros">
                            <label class="o_uprofe_panel_check">
                                <input type="checkbox" t-model="state.soloEnCurso"/> Solo en curso
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="fa fa-search"/></span>
                                <input type="text" class="form-control" placeholder="Buscar nº, universidad o país"
                                       t-model="state.busqueda"/>
                                <button t-if="state.busqueda" class="btn btn-outline-secondary" t-on-click="limpiarBusqueda">
                                    <i class="fa fa-times"/>
                                </button>
                            </div>
                        </div>
                    </div>
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Nº</th><th>Universidad</th><th>País</th><th>Inicio</th><th>Fin</th>
                                <th class="text-end">Días</th><th>Fase</th><th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="movilidades" t-as="mov" t-key="mov.id" class="o_uprofe_panel_fila"
                                t-on-click="() => this.abrirMovilidad(mov)">
                                <td class="fw-bold" t-esc="mov.sNum_movilidad"/>
                                <td t-esc="mov.universidad_id ? mov.universidad_id[1] : '–'"/>
                                <td t-esc="mov.pais_id ? mov.pais_id[1] : '–'"/>
                                <td t-esc="mov.dFecha_inicio"/>
                                <td t-esc="mov.dFecha_fin"/>
                                <td class="text-end" t-esc="mov.iDuracion_dias"/>
                                <td>
                                    <span t-attf-class="badge {{ fase(mov) === 'En curso' ? 'text-bg-success' : 'text-bg-info' }}"
                                          t-esc="fase(mov)"/>
                                </td>
                                <td t-esc="mov.estado_id[1].replaceAll('_', ' ')"/>
                            </tr>
                            <tr t-if="!movilidades.length">
                                <td colspan="8" class="text-center text-muted fst-italic">Ninguna movilidad coincide con la búsqueda.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>
    </t>
</templates>
