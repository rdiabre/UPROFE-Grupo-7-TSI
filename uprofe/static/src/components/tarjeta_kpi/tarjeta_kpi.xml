<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="uprofe.TarjetaKpi">
        <div t-attf-class="o_uprofe_kpi o_uprofe_kpi_{{ props.color }} {{ props.onClick ? 'o_uprofe_kpi_clic' : '' }}"
             t-on-click="onClick" role="button" t-att-title="props.onClick ? 'Ver ' + props.titulo.toLowerCase() : ''">
            <div class="o_uprofe_kpi_icono"><i t-attf-class="fa {{ props.icono }}"/></div>
            <div class="o_uprofe_kpi_texto">
                <div class="o_uprofe_kpi_valor" t-esc="valorFormateado"/>
                <div class="o_uprofe_kpi_titulo" t-esc="props.titulo"/>
            </div>
        </div>
    </t>
</templates>
