<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Informe del learning agreement: formato de papel y acciones (Tema 7.2, Reports).
         Las acciones se cargan antes que las plantillas (learning_agreement_templates.xml). -->

    <record id="paperformat_uprofe_a4" model="report.paperformat">
        <field name="name">UPROFE A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">32</field>
        <field name="margin_bottom">22</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">26</field>
        <field name="dpi">96</field>
    </record>

    <!-- PDF (wkhtmltopdf): aparece en el menú Imprimir del learning agreement -->
    <record id="action_report_learning_agreement" model="ir.actions.report">
        <field name="name">Learning agreement (PDF)</field>
        <field name="model">uprofe.learning_agreement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">uprofe.report_learning_agreement</field>
        <field name="report_file">uprofe.report_learning_agreement</field>
        <field name="print_report_name">'Learning agreement %s v%s' % (object.sNum_la, object.iVersion)</field>
        <field name="paperformat_id" ref="paperformat_uprofe_a4"/>
        <field name="binding_model_id" ref="model_uprofe_learning_agreement"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Misma plantilla en HTML, para previsualizarla en el navegador -->
    <record id="action_report_learning_agreement_html" model="ir.actions.report">
        <field name="name">Learning agreement (vista previa HTML)</field>
        <field name="model">uprofe.learning_agreement</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">uprofe.report_learning_agreement</field>
        <field name="report_file">uprofe.report_learning_agreement</field>
        <field name="paperformat_id" ref="paperformat_uprofe_a4"/>
        <field name="binding_model_id" ref="model_uprofe_learning_agreement"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
