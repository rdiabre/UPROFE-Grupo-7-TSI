<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plantillas QWeb del informe del learning agreement (Tema 7.1 y 7.2).
         Los estilos están en static/src/scss/informe_learning_agreement.scss
         (bundle web.report_assets_common) y van todos bajo la clase .o_uprofe_la. -->

    <!-- Plantilla principal: recorre los documentos y llama a la del documento -->
    <template id="report_learning_agreement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="uprofe.report_learning_agreement_document"/>
            </t>
        </t>
    </template>

    <!-- Un learning agreement -->
    <template id="report_learning_agreement_document">
        <t t-call="web.external_layout">
            <t t-set="res" t-value="resumen[doc.id]"/>
            <t t-set="movilidad" t-value="doc.movilidad_id"/>
            <t t-set="plaza" t-value="movilidad.plaza_erasmus_id"/>
            <t t-set="universidad" t-value="movilidad.universidad_id"/>
            <div class="page o_uprofe_la">

                <!-- ====== Cabecera ====== -->
                <div class="o_la_cabecera">
                    <div class="o_la_cabecera_texto">
                        <div class="o_la_programa">Programa Erasmus+ · Movilidad de estudios</div>
                        <h1>Learning Agreement</h1>
                        <div class="o_la_numero">
                            <span t-field="doc.sNum_la"/> · versión <span t-esc="doc.iVersion"/>
                        </div>
                    </div>
                    <div class="o_la_cabecera_estado">
                        <span t-attf-class="o_la_badge o_la_color_{{ doc.estado_id.iColor }}"
                              t-esc="humanizar(doc.estado_id.sName)"/>
                        <div class="o_la_firma_fecha">
                            <t t-if="doc.dFecha_firma">Firmado el <span t-field="doc.dFecha_firma"/></t>
                            <t t-else="">Pendiente de firma</t>
                        </div>
                    </div>
                </div>

                <!-- ====== Datos de la movilidad, el destino y la plaza ====== -->
                <table class="o_la_fichas">
                    <tr>
                        <td class="o_la_ficha">
                            <div class="o_la_ficha_titulo">Movilidad</div>
                            <dl>
                                <dt>Número</dt><dd><span t-field="movilidad.sNum_movilidad"/></dd>
                                <dt>Periodo</dt>
                                <dd><span t-field="movilidad.dFecha_inicio"/> – <span t-field="movilidad.dFecha_fin"/></dd>
                                <dt>Duración</dt>
                                <dd><t t-esc="movilidad.iDuracion_dias"/> días (<t t-esc="movilidad.fDuracion_meses"/> meses)</dd>
                                <dt>Estado</dt><dd t-esc="humanizar(movilidad.estado_id.sName)"/>
                            </dl>
                        </td>
                        <td class="o_la_ficha">
                            <div class="o_la_ficha_titulo">Universidad de destino</div>
                            <dl t-if="universidad">
                                <dt>Universidad</dt><dd><span t-field="universidad.sName"/></dd>
                                <dt>Código Erasmus</dt><dd><span t-field="universidad.cod_erasmus"/></dd>
                                <dt>Ciudad</dt><dd><t t-esc="universidad.ciudad_id.sName"/>, <t t-esc="universidad.pais_id.sName"/></dd>
                                <dt>Idiomas</dt><dd t-esc="', '.join(universidad.idioma_ids.mapped('sName'))"/>
                            </dl>
                            <p t-else="" class="o_la_vacio">La movilidad no tiene plaza asignada.</p>
                        </td>
                        <td class="o_la_ficha">
                            <div class="o_la_ficha_titulo">Plaza</div>
                            <dl t-if="plaza">
                                <dt>Código</dt><dd><span t-field="plaza.cod_plaza"/></dd>
                                <dt>Nivel</dt><dd t-esc="humanizar(plaza.nivel_estudios_id.sName)"/>
                                <dt>Idioma exigido</dt>
                                <dd><t t-esc="plaza.idioma_id.sName"/> (<span t-field="plaza.sNivel_idioma"/>)</dd>
                                <dt>Ayuda</dt>
                                <dd><t t-esc="'%.2f' % plaza.fAyuda_mensual"/> €/mes · total <t t-esc="'%.2f' % plaza.fAyuda_total"/> €</dd>
                            </dl>
                            <p t-else="" class="o_la_vacio">Sin plaza asignada.</p>
                        </td>
                    </tr>
                </table>

                <!-- ====== Indicadores ====== -->
                <table class="o_la_kpis">
                    <tr>
                        <td class="o_la_kpi">
                            <div class="o_la_kpi_valor" t-esc="doc.iNum_lineas"/>
                            <div class="o_la_kpi_titulo">Asignaturas</div>
                        </td>
                        <td class="o_la_kpi">
                            <div class="o_la_kpi_valor" t-esc="'%g' % doc.fCreditos_totales"/>
                            <div class="o_la_kpi_titulo">Créditos ECTS</div>
                        </td>
                        <td class="o_la_kpi">
                            <div class="o_la_kpi_valor" t-esc="'%g' % doc.fCreditos_reconocidos"/>
                            <div class="o_la_kpi_titulo">Créditos reconocidos</div>
                        </td>
                        <td class="o_la_kpi">
                            <div class="o_la_kpi_valor">
                                <t t-if="doc.fNota_media" t-esc="'%.2f' % doc.fNota_media"/>
                                <t t-else="">–</t>
                            </div>
                            <div class="o_la_kpi_titulo">Nota media</div>
                        </td>
                    </tr>
                </table>
                <div class="o_la_progreso">
                    <div class="o_la_progreso_texto">
                        Reconocido el <strong t-esc="res['porcentaje']"/>% de los créditos del acuerdo
                    </div>
                    <div class="o_la_progreso_barra">
                        <div t-attf-class="o_la_progreso_relleno {{ 'o_la_completo' if res['porcentaje'] &gt;= 100 else '' }}"
                             t-attf-style="width: {{ res['porcentaje'] }}%;"/>
                    </div>
                </div>

                <!-- ====== Líneas del acuerdo ====== -->
                <h2 class="o_la_seccion">Asignaturas del acuerdo</h2>
                <table class="o_la_tabla">
                    <thead>
                        <tr>
                            <th class="o_la_centro">Nº</th>
                            <th>Código</th>
                            <th>Asignatura de destino</th>
                            <th>Semestre</th>
                            <th class="o_la_num">ECTS</th>
                            <th>Estado</th>
                            <th class="o_la_num">Nota</th>
                            <th>Calificación</th>
                            <th class="o_la_num">Reconocidos</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.linea_ids" t-as="linea">
                            <tr t-attf-class="{{ 'o_la_par' if linea_index % 2 else '' }}">
                                <td class="o_la_centro" t-esc="linea.iNum_linea"/>
                                <td class="o_la_codigo" t-esc="linea.asignatura_destino_id.cod_asig_destino"/>
                                <td t-esc="linea.asignatura_destino_id.sName"/>
                                <td><span t-field="linea.asignatura_destino_id.sSemestre"/></td>
                                <td class="o_la_num" t-esc="'%g' % linea.fCreditos_ects"/>
                                <td>
                                    <span t-attf-class="o_la_badge o_la_badge_peq o_la_color_{{ linea.estado_id.iColor }}"
                                          t-esc="humanizar(linea.estado_id.sName)"/>
                                </td>
                                <td class="o_la_num">
                                    <t t-if="linea.fNota" t-esc="'%.1f' % linea.fNota"/>
                                    <t t-else="">–</t>
                                </td>
                                <td>
                                    <span t-if="linea.sCalificacion"
                                          t-attf-class="o_la_nota o_la_nota_{{ linea.sCalificacion.lower() }}"
                                          t-esc="linea.sCalificacion"/>
                                </td>
                                <td class="o_la_num" t-esc="'%g' % linea.fCreditos_reconocidos"/>
                            </tr>
                        </t>
                        <tr t-if="not doc.linea_ids">
                            <td colspan="9" class="o_la_vacio o_la_centro">El acuerdo todavía no tiene asignaturas.</td>
                        </tr>
                    </tbody>
                    <tfoot t-if="doc.linea_ids">
                        <tr>
                            <td colspan="4">Total</td>
                            <td class="o_la_num" t-esc="'%g' % doc.fCreditos_totales"/>
                            <td colspan="3"/>
                            <td class="o_la_num" t-esc="'%g' % doc.fCreditos_reconocidos"/>
                        </tr>
                    </tfoot>
                </table>

                <!-- ====== Resumen por estado e historial de versiones ====== -->
                <table class="o_la_doble">
                    <tr>
                        <td>
                            <h2 class="o_la_seccion">Resumen por estado</h2>
                            <table class="o_la_tabla o_la_tabla_peq">
                                <thead><tr><th>Estado</th><th class="o_la_num">Líneas</th><th class="o_la_num">ECTS</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="res['por_estado']" t-as="fila">
                                        <td>
                                            <span t-attf-class="o_la_punto o_la_color_{{ fila['estado'].iColor }}"/>
                                            <t t-esc="humanizar(fila['estado'].sName)"/>
                                        </td>
                                        <td class="o_la_num" t-esc="fila['lineas']"/>
                                        <td class="o_la_num" t-esc="'%g' % fila['creditos']"/>
                                    </tr>
                                    <tr t-if="not res['por_estado']"><td colspan="3" class="o_la_vacio">Sin líneas.</td></tr>
                                </tbody>
                            </table>
                        </td>
                        <td>
                            <h2 class="o_la_seccion">Historial de versiones</h2>
                            <table class="o_la_tabla o_la_tabla_peq">
                                <thead><tr><th>Versión</th><th>Número</th><th>Estado</th><th>Firma</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="res['versiones']" t-as="version"
                                        t-attf-class="{{ 'o_la_actual' if version == doc else '' }}">
                                        <td>v<t t-esc="version.iVersion"/></td>
                                        <td t-esc="version.sNum_la"/>
                                        <td t-esc="humanizar(version.estado_id.sName)"/>
                                        <td>
                                            <span t-if="version.dFecha_firma" t-field="version.dFecha_firma"/>
                                            <t t-else="">–</t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- ====== Observaciones ====== -->
                <div t-if="doc.sObservaciones" class="o_la_observaciones">
                    <h2 class="o_la_seccion">Observaciones</h2>
                    <p t-field="doc.sObservaciones"/>
                </div>

                <!-- ====== Firmas ====== -->
                <h2 class="o_la_seccion">Firmas</h2>
                <table class="o_la_firmas">
                    <tr>
                        <t t-foreach="res['firmas']" t-as="firma">
                            <td t-attf-class="o_la_firma {{ 'o_la_firmada' if firma['firmada'] else 'o_la_pendiente' }}">
                                <div class="o_la_firma_rol" t-esc="firma['titulo']"/>
                                <div class="o_la_firma_espacio">
                                    <t t-if="firma['firmada']">✔ Firmado</t>
                                    <t t-elif="doc.estado_id.bFinal">No firmado</t>
                                    <t t-else="">Pendiente</t>
                                </div>
                                <div class="o_la_firma_pie">
                                    <t t-if="firma['firmada']">Fecha: <span t-field="doc.dFecha_firma"/></t>
                                    <t t-else="">Fecha: ____ / ____ / ________</t>
                                </div>
                            </td>
                        </t>
                    </tr>
                </table>

                <div class="o_la_emision">
                    Documento generado el <t t-esc="fecha_emision.strftime('%d/%m/%Y a las %H:%M')"/>
                    por <t t-esc="user.name"/> desde UPROFE.
                </div>
            </div>
        </t>
    </template>
</odoo>
