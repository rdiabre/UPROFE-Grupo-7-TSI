<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de listas -->
    <record id="view_uprofe_tutor_externo_list" model="ir.ui.view">
        <field name="name">uprofe.tutor_externo.list</field>
        <field name="model">uprofe.tutor_externo</field>
        <field name="arch" type="xml">
            <list string="Tutores externos">
                <field name="name"/>
                <field name="apellidos"/>
                <field name="dni"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="view_uprofe_tutor_externo_form" model="ir.ui.view">
        <field name="name">uprofe.tutor_externo.form</field>
        <field name="model">uprofe.tutor_externo</field>
        <field name="arch" type="xml">
            <form string="Tutor externo">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="apellidos"/>
                            <field name="dni"/>
                        </group>
                        <group>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista avanzada -->
    <record id="view_uprofe_tutor_externo_kanban" model="ir.ui.view">
        <field name="name">uprofe.tutor_externo.kanban</field>
        <field name="model">uprofe.tutor_externo</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="apellidos"/>
                <field name="email"/>
                <field name="phone"/>
                <templates>
                    <t t-name="card">
                        <div class="fw-bold fs-5">
                            <field name="name"/> <field name="apellidos"/>
                        </div>
                        <div><field name="email"/></div>
                        <div><field name="phone"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- busqueda -->
    <record id="view_uprofe_tutor_externo_search" model="ir.ui.view">
        <field name="name">uprofe.tutor_externo.search</field>
        <field name="model">uprofe.tutor_externo</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="apellidos"/>
                <field name="dni"/>
                <field name="email"/>
            </search>
        </field>
    </record>

    <!-- accion -->
    <record id="action_uprofe_tutor_externo" model="ir.actions.act_window">
        <field name="name">Tutores externos</field>
        <field name="res_model">uprofe.tutor_externo</field>
        <field name="search_view_id" ref="view_uprofe_tutor_externo_search"/>
        <field name="view_mode">list,form,kanban</field>
    </record>
</odoo>