<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_uprofe_recibo_calendar" model="ir.ui.view">
        <field name="name">uprofe.recibo.calendar</field>
        <field name="model">uprofe.recibo</field>
        <field name="arch" type="xml">
            <calendar string="Pagos de recibos" date_start="dFecha" color="tasa_id" mode="month">
                <field name="name"/>
                <field name="tasa_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_uprofe_recibo_form" model="ir.ui.view">
        <field name="name">uprofe.recibo.form</field>
        <field name="model">uprofe.recibo</field>
        <field name="arch" type="xml">
            <form string="Recibo">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tasa_id"/>
                            <field name="iNumero_plazo"/>
                            <field name="metodo_pago_id"/>
                        </group>
                        <group>
                            <field name="fImporte"/>
                            <field name="dFecha"/>
                            <field name="dFecha_limite"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_uprofe_recibo_list" model="ir.ui.view">
        <field name="name">uprofe.recibo.list</field>
        <field name="model">uprofe.recibo</field>
        <field name="arch" type="xml">
            <list string="Recibos">
                <field name="name"/>
                <field name="tasa_id"/>
                <field name="iNumero_plazo"/>
                <field name="fImporte"/>
                <field name="dFecha"/>
                <field name="dFecha_limite"/>
                <field name="metodo_pago_id"/>
            </list>
        </field>
    </record>

    <record id="view_uprofe_recibo_search" model="ir.ui.view">
        <field name="name">uprofe.recibo.search</field>
        <field name="model">uprofe.recibo</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tasa_id"/>
                <field name="metodo_pago_id"/>

                <group expand="0" string="Agrupar por">
                    <filter name="group_tasa"
                            string="Tasa"
                            context="{'group_by': 'tasa_id'}"/>
                    <filter name="group_metodo"
                            string="Método de pago"
                            context="{'group_by': 'metodo_pago_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_uprofe_recibo" model="ir.actions.act_window">
        <field name="name">Recibos</field>
        <field name="res_model">uprofe.recibo</field>
        <field name="search_view_id" ref="view_uprofe_recibo_search"/>
        <field name="view_mode">list,form,calendar</field>
    </record>
</odoo>