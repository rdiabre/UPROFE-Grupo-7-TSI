<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VISTA FORM -->
    <record id="view_convocatoria_asignatura_form" model="ir.ui.view">
        <field name="name">uprofe.convocatoria_asignatura.form</field>
        <field name="model">uprofe.convocatoria_asignatura</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="sTipo"/>
                            <field name="fPorcentaje"/>
                        </group>
                        <group>
                            <field name="dFecha"/>
                            <field name="fHora" widget="float_time"/>
                            <field name="fDuracion" widget="float_time"/>
                        </group>
                    </group>
                    <!-- Relaciones futuras (Comentadas temporalmente) -->
                    <!--
                    <group string="Asignaciones">
                        <field name="asignatura_id"/>
                        <field name="aula_id"/>
                        <field name="alumno_id"/>
                        <field name="linea_acta_id"/>
                    </group>
                    -->
                </sheet>
            </form>
        </field>
    </record>

    <!-- VISTA LIST -->
    <record id="view_convocatoria_asignatura_list" model="ir.ui.view">
        <field name="name">uprofe.convocatoria_asignatura.list</field>
        <field name="model">uprofe.convocatoria_asignatura</field>
        <field name="arch" type="xml">
            <list>
                <field name="dFecha"/>
                <field name="sTipo"/>
                <field name="fHora" widget="float_time"/>
                <field name="fDuracion" widget="float_time"/>
                <field name="fPorcentaje"/>
            </list>
        </field>
    </record>

    <!-- VISTA KANBAN -->
    <record id="view_convocatoria_asignatura_kanban" model="ir.ui.view">
        <field name="name">uprofe.convocatoria_asignatura.kanban</field>
        <field name="model">uprofe.convocatoria_asignatura</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="sTipo"/>
                <field name="dFecha"/>
                <field name="fHora"/>
                <field name="fDuracion"/>
                <field name="fPorcentaje"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong>Convocatoria <field name="sTipo"/></strong>
                            <div>Fecha: <field name="dFecha"/> (<field name="fHora" widget="float_time"/>)</div>
                            <div>Duración: <field name="fDuracion" widget="float_time"/> h | Peso: <field name="fPorcentaje"/>%</div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- VISTA CALENDARIO -->
    <record id="view_convocatoria_asignatura_calendar" model="ir.ui.view">
        <field name="name">uprofe.convocatoria_asignatura.calendar</field>
        <field name="model">uprofe.convocatoria_asignatura</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de convocatorias" 
                      date_start="dFecha" 
                      color="sTipo" 
                      mode="month">
                <field name="sTipo"/>
                <field name="fHora" widget="float_time"/>
            </calendar>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="action_uprofe_convocatoria_asignatura" model="ir.actions.act_window">
        <field name="name">Convocatorias</field>
        <field name="res_model">uprofe.convocatoria_asignatura</field>
        <field name="view_mode">list,kanban,form,calendar</field>
    </record>

    <!-- MENÚ -->
    <menuitem id="menu_uprofe_convocatoria_asignatura" 
              name="Convocatorias" 
              parent="uprofe_menu" 
              action="action_uprofe_convocatoria_asignatura" 
              sequence="70"/>
</odoo>
