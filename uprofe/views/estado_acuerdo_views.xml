<odoo>
    <!-- Vista de lista -->
    <record id="view_estado_acuerdo_list" model="ir.ui.view">
        <field name="name">uprofe.estado_acuerdo.list</field>
        <field name="model">uprofe.estado_acuerdo</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sDescripcion"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="view_estado_acuerdo_form" model="ir.ui.view">
        <field name="name">uprofe.estado_acuerdo.form</field>
        <field name="model">uprofe.estado_acuerdo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sDescripcion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista kanban (avanzada) -->
    <record id="view_estado_acuerdo_kanban" model="ir.ui.view">
        <field name="name">uprofe.estado_acuerdo.kanban</field>
        <field name="model">uprofe.estado_acuerdo</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="sDescripcion"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Búsqueda -->
    <record id="view_estado_acuerdo_search" model="ir.ui.view">
        <field name="name">uprofe.estado_acuerdo.search</field>
        <field name="model">uprofe.estado_acuerdo</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sDescripcion"/>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="estado_acuerdo_list_action" model="ir.actions.act_window">
        <field name="name">Estados de acuerdo</field>
        <field name="res_model">uprofe.estado_acuerdo</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer estado de acuerdo</p>
        </field>
    </record>
</odoo>