<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VISTA FORM -->
    <record id="view_horario_tutoria_form" model="ir.ui.view">
        <field name="name">uprofe.horario_tutoria.form</field>
        <field name="model">uprofe.horario_tutoria</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="sUsuProfesor"/>
                            <field name="dFecha"/>
                        </group>
                        <group>
                            <field name="fHoraIni" widget="float_time"/>
                            <field name="fHoraFin" widget="float_time"/>
                        </group>
                    </group>
                    <!--
                    <group string="Asignaciones">
                        <field name="tutoria_id"/>
                        <field name="profesor_id"/>
                        <field name="aula_id"/>
                    </group>
                    -->
                </sheet>
            </form>
        </field>
    </record>

    <!-- VISTA LIST -->
    <record id="view_horario_tutoria_list" model="ir.ui.view">
        <field name="name">uprofe.horario_tutoria.list</field>
        <field name="model">uprofe.horario_tutoria</field>
        <field name="arch" type="xml">
            <list>
                <field name="dFecha"/>
                <field name="sUsuProfesor"/>
                <field name="fHoraIni" widget="float_time"/>
                <field name="fHoraFin" widget="float_time"/>
                <!-- <field name="aula_id"/> -->
            </list>
        </field>
    </record>

    <!-- VISTA KANBAN -->
    <record id="view_horario_tutoria_kanban" model="ir.ui.view">
        <field name="name">uprofe.horario_tutoria.kanban</field>
        <field name="model">uprofe.horario_tutoria</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="sUsuProfesor"/>
                <field name="dFecha"/>
                <field name="fHoraIni"/>
                <field name="fHoraFin"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="sUsuProfesor"/></strong>
                            <div>Fecha: <field name="dFecha"/></div>
                            <div>Horario: <field name="fHoraIni" widget="float_time"/> - <field name="fHoraFin" widget="float_time"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="action_uprofe_horario_tutoria" model="ir.actions.act_window">
        <field name="name">Horarios de Tutoría</field>
        <field name="res_model">uprofe.horario_tutoria</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- MENÚ -->
    <menuitem id="menu_uprofe_horario_tutoria" 
              name="Tutorías" 
              parent="uprofe_menu" 
              action="action_uprofe_horario_tutoria" 
              sequence="50"/>
</odoo>
