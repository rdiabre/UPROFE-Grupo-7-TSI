<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_uprofe_tipo_respuesta_list" model="ir.ui.view">
        <field name="name">uprofe.tipo_respuesta.list</field>
        <field name="model">uprofe.tipo_respuesta</field>
        <field name="arch" type="xml">
            <list string="Tipos de respuesta">
                <field name="name"/>
                <field name="bconopciones"/>
            </list>
        </field>
    </record>

    <record id="view_uprofe_tipo_respuesta_form" model="ir.ui.view">
        <field name="name">uprofe.tipo_respuesta.form</field>
        <field name="model">uprofe.tipo_respuesta</field>
        <field name="arch" type="xml">
            <form string="Tipo de respuesta">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="bconopciones"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista avanzada-->
    <record id="view_uprofe_tipo_respuesta_graph" model="ir.ui.view">
        <field name="name">uprofe.tipo_respuesta.graph</field>
        <field name="model">uprofe.tipo_respuesta</field>
        <field name="arch" type="xml">
            <graph string="Tipos de respuesta" type="pie">
                <field name="bconopciones"/>
            </graph>
        </field>
    </record>

    <record id="action_uprofe_tipo_respuesta" model="ir.actions.act_window">
        <field name="name">Tipos de respuesta</field>
        <field name="res_model">uprofe.tipo_respuesta</field>
        <field name="view_mode">list,form,graph</field>
    </record>
</odoo>