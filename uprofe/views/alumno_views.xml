<odoo>
    <record id="view_alumno_list" model="ir.ui.view">
        <field name="name">uprofe.alumno.list</field>
        <field name="model">uprofe.alumno</field>
        <field name="arch" type="xml">
            <list>
                <field name="sDni"/>
                <field name="name" string="Nombre"/>
                <field name="sApellidos"/>
                <field name="email" string="Correo electrónico"/>
                <field name="usuario_id"/>
                <field name="dtFechaIngreso"/>
                <field name="iCursoActual"/>
                <field name="iNum_sesiones"/>
            </list>
        </field>
    </record>

    <record id="view_alumno_form" model="ir.ui.view">
        <field name="name">uprofe.alumno.form</field>
        <field name="model">uprofe.alumno</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <!-- Herencia de Persona -->
                        <group string="Datos personales">
                            <!-- Si la persona ya existe, se elige aquí y se rellenan sus datos. Si no, se deja vacío y se crea al guardar -->
                            <field name="persona_id" string="Persona existente" required="0"/>
                            <field name="sDni"/>
                            <field name="name" string="Nombre"/>
                            <field name="sApellidos"/>
                            <field name="email" string="Correo electrónico" required="1"/>
                            <field name="phone" string="Teléfono" required="1"/>
                        </group>
                        <group string="Datos del alumno">
                            <field name="usuario_id"/>
                            <field name="dtFechaIngreso"/>
                            <field name="iCursoActual"/>
                            <field name="sesion_ids" widget="many2many_tags"/>
                            <field name="iNum_sesiones"/>
                            <field name="fHoras_matriculadas"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_alumno_search" model="ir.ui.view">
        <field name="name">uprofe.alumno.search</field>
        <field name="model">uprofe.alumno</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Nombre"/>
                <field name="sApellidos"/>
                <field name="sDni"/>
                <field name="usuario_id"/>
                <field name="iCursoActual"/>
                <group string="Agrupar por">
                    <filter name="group_curso_actual" string="Curso actual" context="{'group_by': 'iCursoActual'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="alumno_list_action" model="ir.actions.act_window">
        <field name="name">Alumnos</field>
        <field name="res_model">uprofe.alumno</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer alumno</p>
        </field>
    </record>
</odoo>