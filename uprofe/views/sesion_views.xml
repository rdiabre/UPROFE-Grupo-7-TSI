<odoo>
    <!-- List -->
    <record id="view_sesion_list" model="ir.ui.view">
        <field name="name">uprofe.sesion.list</field>
        <field name="model">uprofe.sesion</field>
        <field name="arch" type="xml">
            <list>
                <field name="dFecha"/>
                <field name="fHora_ini" widget="float_time"/>
                <field name="fHora_fin" widget="float_time"/>
                <field name="asignatura_id"/>
                <field name="iN_sesion"/>
                <field name="tipo_sesion_id"/>
                <field name="profesor_ids" widget="many2many_tags"/>
                <!-- sum: total de horas al pie de la lista (y de cada grupo) -->
                <field name="fDuracion" widget="float_time" sum="Total de horas" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_sesion_form" model="ir.ui.view">
        <field name="name">uprofe.sesion.form</field>
        <field name="model">uprofe.sesion</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Sesión">
                            <field name="asignatura_id"/>
                            <field name="iN_sesion"/>
                            <field name="tipo_sesion_id"/>
                            <field name="profesor_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Horario">
                            <field name="dFecha"/>
                            <!-- float_time: muestra 9.5 como 09:30 -->
                            <field name="fHora_ini" widget="float_time"/>
                            <field name="fHora_fin" widget="float_time"/>
                            <field name="fDuracion" widget="float_time"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_sesion_search" model="ir.ui.view">
        <field name="name">uprofe.sesion.search</field>
        <field name="model">uprofe.sesion</field>
        <field name="arch" type="xml">
            <search>
                <field name="asignatura_id"/>
                <field name="profesor_ids"/>
                <field name="tipo_sesion_id"/>
                <filter name="filtro_hoy" string="Hoy"
                        domain="[('dFecha', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filtro_proximas" string="Próximas"
                        domain="[('dFecha', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filtro_fecha" string="Fecha" date="dFecha"/>
                <group expand="0" string="Agrupar por">
                    <filter name="agrupar_asignatura" string="Asignatura" context="{'group_by': 'asignatura_id'}"/>
                    <filter name="agrupar_tipo" string="Tipo de sesión" context="{'group_by': 'tipo_sesion_id'}"/>
                    <filter name="agrupar_semana" string="Semana" context="{'group_by': 'dFecha:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vista avanzada: calendario semanal, un color por asignatura. Usa dtInicio y dtFin; al arrastrar una sesión se cambian la fecha y las horas (inverse) -->
    <record id="view_sesion_calendar" model="ir.ui.view">
        <field name="name">uprofe.sesion.calendar</field>
        <field name="model">uprofe.sesion</field>
        <field name="arch" type="xml">
            <calendar string="Sesiones" date_start="dtInicio" date_stop="dtFin" color="asignatura_id"
                      mode="week" quick_create="0">
                <field name="asignatura_id"/>
                <field name="tipo_sesion_id"/>
                <field name="profesor_ids" widget="many2many_tags"/>
            </calendar>
        </field>
    </record>

    <!-- Action: se abre en el calendario -->
    <record id="sesion_list_action" model="ir.actions.act_window">
        <field name="name">Sesiones</field>
        <field name="res_model">uprofe.sesion</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Programa la primera sesión</p>
        </field>
    </record>
</odoo>
