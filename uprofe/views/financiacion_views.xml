<odoo>
    <record id="uprofe_financiacion_pivot_view" model="ir.ui.view">
        <field name="name">uprofe.financiacion.pivot</field>
        <field name="model">uprofe.financiacion</field>
        <field name="arch" type="xml">
            <pivot string="Financiación">
                <field name="iEmpresa_id" type="row"/>
                <field name="dFecha_concesion" interval="year" type="col"/>
                <field name="fImporte" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="uprofe_financiacion_form_view" model="ir.ui.view">
        <field name="name">uprofe.financiacion.form</field>
        <field name="model">uprofe.financiacion</field>
        <field name="arch" type="xml">
            <form string="Financiaciones">
                <sheet layout="auto">
                    <group>
                        <field name="sName" />
                        <field name="fImporte" />
                        <field name="dFecha_concesion" />
                        <field name="iProyecto_investigacion_id" widget="many2one" />
                        <field name="lPersona_ids" widget="many2many">
                            <list>
                                <field name="sName" />
                                <field name="sNombre" />
                                <field name="sApellidos" />
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="uprofe_financiacion_list_view" model="ir.ui.view">
        <field name="name">uprofe.financiacion.list</field>
        <field name="model">uprofe.financiacion</field>
        <field name="arch" type="xml">
            <list string="Lista de financiaciones">
                <field name="sName" />
                <field name="fImporte" />
                <field name="dFecha_concesion" />
                <field name="iProyecto_investigacion_id" widget="many2one" />
                <field name="iGrupo_inv_id" widget="many2one" />
                <field name="lPersona_ids" widget="many2many" />
            </list>
        </field>
    </record>

    <record id="financiacion_list_action" model="ir.actions.act_window">
        <field name="name">Financiaciones</field>
        <field name="res_model">uprofe.financiacion</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Añade la primera financiación</p>
        </field>
    </record>
</odoo>