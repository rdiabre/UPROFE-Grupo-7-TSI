
<odoo>
    <!-- Vista de lista -->
    <record id="view_doc_adjunta_list" model="ir.ui.view">
        <field name="name">uprofe.doc_adjunta.list</field>
        <field name="model">uprofe.doc_adjunta</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sNombreFichero"/>
                <field name="sTipoDocumento"/>
                <field name="dFechaSubida"/>
                <field name="solicitud_id"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="view_doc_adjunta_form" model="ir.ui.view">
        <field name="name">uprofe.doc_adjunta.form</field>
        <field name="model">uprofe.doc_adjunta</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sTipoDocumento"/>
                            <field name="dFechaSubida"/>
                        </group>
                        <group>
                            <field name="solicitud_id" widget="many2one"/>
                            <field name="sNombreFichero"/>
                            <field name="binFichero" filename="sNombreFichero"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista kanban agrupada por solicitud -->
    <record id="view_doc_adjunta_kanban" model="ir.ui.view">
        <field name="name">uprofe.doc_adjunta.kanban</field>
        <field name="model">uprofe.doc_adjunta</field>
        <field name="arch" type="xml">
            <kanban default_group_by="solicitud_id">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="sNombreFichero"/>
                        <field name="sTipoDocumento"/>
                        <field name="dFechaSubida"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Búsqueda -->
    <record id="view_doc_adjunta_search" model="ir.ui.view">
        <field name="name">uprofe.doc_adjunta.search</field>
        <field name="model">uprofe.doc_adjunta</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sNombreFichero"/>
                <field name="sTipoDocumento"/>
                <field name="solicitud_id"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_solicitud" string="Solicitud" context="{'group_by': 'solicitud_id'}"/>
                    <filter name="group_tipo" string="Tipo de documento" context="{'group_by': 'sTipoDocumento'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="doc_adjunta_list_action" model="ir.actions.act_window">
        <field name="name">Documentos adjuntos</field>
        <field name="res_model">uprofe.doc_adjunta</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Adjunta el primer documento</p>
        </field>
    </record>
</odoo>
