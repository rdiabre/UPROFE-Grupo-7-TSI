<odoo>
    <record id="uprofe_patente_calendar_view" model="ir.ui.view">
        <field name="name">uprofe.patente.calendar</field>
        <field name="model">uprofe.patente</field>
        <field name="arch" type="xml">
            <calendar string="Patentes"
                    date_start="dFecha_concesion"
                    mode="month"
                    quick_create="0">
                <field name="sNumero_patente"/>
                <field name="sTitulo"/>
            </calendar>
        </field>
    </record>

    <record id="uprofe_patente_form_view" model="ir.ui.view">
        <field name="name">uprofe.patente.form</field>
        <field name="model">uprofe.patente</field>
        <field name="arch" type="xml">
            <form string="Patente">
                <sheet>
                    <group>
                        <group string="Datos de la publicación">
                            <field name="sName"/>
                            <field name="sTitulo"/>
                            <field name="dFecha_publicacion"/>
                        </group>
                        <group string="Datos de la patente">
                            <field name="sNumero_patente"/>
                            <field name="dFecha_concesion"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Autores">
                            <group>
                                <field name="profesor_ids" widget="many2many_tags"/>
                                <!--<field name="investigador_ids" widget="many2many_tags"/>-->
                            </group>
                        </page>
                        <page string="Proyecto">
                            <field name="proyecto_investigacion_id"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="uprofe_patente_list_view" model="ir.ui.view">
        <field name="name">uprofe.patente.list</field>
        <field name="model">uprofe.patente</field>
        <field name="arch" type="xml">
            <list string="Patentes">
                <field name="sName"/>
                <field name="sTitulo"/>
                <field name="dFecha_publicacion"/>
                <field name="sNumero_patente"/>
                <field name="dFecha_concesion"/>
            </list>
        </field>
    </record>

    <record id="patente_list_action" model="ir.actions.act_window">
        <field name="name">Patentes</field>
        <field name="res_model">uprofe.patente</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Añade la primera patente</p>
        </field>
    </record>
</odoo>