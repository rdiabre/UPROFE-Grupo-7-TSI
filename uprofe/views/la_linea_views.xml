<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Lista: se usa cuando se abre la_linea desde la pestaña de otro modelo -->
    <record id="view_uprofe_la_linea_list" model="ir.ui.view">
        <field name="name">uprofe.la_linea.list</field>
        <field name="model">uprofe.la_linea</field>
        <field name="arch" type="xml">
            <list>
                <field name="learning_agreement_id"/>
                <field name="iNum_linea"/>
                <field name="asignatura_destino_id"/>
                <field name="universidad_id" optional="hide"/>
                <field name="estado_id"/>
                <field name="fNota"/>
                <field name="sCalificacion" widget="uprofe_insignia_calificacion"/>
                <field name="fCreditos_reconocidos" sum="Total"/>
            </list>
        </field>
    </record>

    <!-- Formulario: ventana emergente al abrir una línea -->
    <record id="view_uprofe_la_linea_form" model="ir.ui.view">
        <field name="name">uprofe.la_linea.form</field>
        <field name="model">uprofe.la_linea</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Línea">
                            <field name="learning_agreement_id"/>
                            <field name="iNum_linea"/>
                            <field name="estado_id"/>
                        </group>
                        <group string="Asignatura y resultado">
                            <field name="asignatura_destino_id"/>
                            <field name="universidad_id"/>
                            <field name="fCreditos_ects"/>
                            <field name="fNota"/>
                            <field name="sCalificacion" widget="uprofe_insignia_calificacion"/>
                            <field name="fCreditos_reconocidos"/>
                        </group>
                    </group>
                    <field name="sObservaciones" placeholder="Observaciones sobre la línea"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Graph: créditos reconocidos por estado de la línea -->
    <record id="view_uprofe_la_linea_graph" model="ir.ui.view">
        <field name="name">uprofe.la_linea.graph</field>
        <field name="model">uprofe.la_linea</field>
        <field name="arch" type="xml">
            <graph string="Créditos reconocidos por estado" type="bar">
                <field name="estado_id"/>
                <field name="fCreditos_reconocidos" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Kanban (cards): la línea no tiene fechas, así que en lugar de Calendar se muestran tarjetas -->
    <record id="view_uprofe_la_linea_kanban" model="ir.ui.view">
        <field name="name">uprofe.la_linea.kanban</field>
        <field name="model">uprofe.la_linea</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estado_id">
                <templates>
                    <t t-name="card">
                        <div class="fw-bold fs-5"><field name="learning_agreement_id"/> · línea <field name="iNum_linea"/></div>
                        <div><field name="asignatura_destino_id"/></div>
                        <div>Nota: <field name="fNota"/> (<field name="sCalificacion"/>)</div>
                        <div>Créditos reconocidos: <field name="fCreditos_reconocidos"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Búsqueda y filtros -->
    <record id="view_uprofe_la_linea_search" model="ir.ui.view">
        <field name="name">uprofe.la_linea.search</field>
        <field name="model">uprofe.la_linea</field>
        <field name="arch" type="xml">
            <search>
                <field name="learning_agreement_id"/>
                <field name="asignatura_destino_id"/>
                <field name="universidad_id"/>
                <field name="estado_id"/>
                <filter string="Con nota" name="con_nota" domain="[('fNota', '!=', 0)]"/>
                <filter string="Aprobadas (5 o más)" name="aprobadas" domain="[('fNota', '&gt;=', 5)]"/>
                <filter string="Suspensas (menos de 5)" name="suspensas" domain="[('fNota', '&gt;', 0), ('fNota', '&lt;', 5)]"/>
                <separator/>
                <filter string="Con créditos reconocidos" name="reconocidas" domain="[('fCreditos_reconocidos', '&gt;', 0)]"/>
                <group string="Agrupar por">
                    <filter string="Learning agreement" name="group_la" context="{'group_by': 'learning_agreement_id'}"/>
                    <filter string="Estado" name="group_estado" context="{'group_by': 'estado_id'}"/>
                    <filter string="Universidad" name="group_universidad" context="{'group_by': 'universidad_id'}"/>
                    <filter string="Calificación" name="group_calificacion" context="{'group_by': 'sCalificacion'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción solo de análisis: el Graph y las cards necesitan una acción para poder abrirse.
         Se bloquea la creación porque las líneas se crean dentro del
         learning agreement (pestaña "Líneas"). -->
    <record id="action_uprofe_la_linea" model="ir.actions.act_window">
        <field name="name">Análisis de líneas</field>
        <field name="res_model">uprofe.la_linea</field>
        <field name="view_mode">graph,kanban,list,form</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
