<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_uprofe_convenio_empresa_calendar" model="ir.ui.view">
        <field name="name">uprofe.convenio_empresa.calendar</field>
        <field name="model">uprofe.convenio_empresa</field>
        <field name="arch" type="xml">
            <calendar string="Convenios" date_start="dFecha_firma" date_stop="dFecha_expiracion"
                      color="estado_convenio_id" mode="month">
                <field name="name"/>
                <field name="estado_convenio_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_uprofe_convenio_empresa_form" model="ir.ui.view">
        <field name="name">uprofe.convenio_empresa.form</field>
        <field name="model">uprofe.convenio_empresa</field>
        <field name="arch" type="xml">
            <form string="Convenio de prácticas">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="estado_convenio_id"/>
                        </group>
                        <group>
                            <field name="dFecha_firma"/>
                            <field name="dFecha_expiracion"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_uprofe_convenio_empresa_list" model="ir.ui.view">
        <field name="name">uprofe.convenio_empresa.list</field>
        <field name="model">uprofe.convenio_empresa</field>
        <field name="arch" type="xml">
            <list string="Convenios">
                <field name="name"/>
                <field name="dFecha_firma"/>
                <field name="dFecha_expiracion"/>
                <field name="estado_convenio_id"/>
            </list>
        </field>
    </record>

    <record id="view_uprofe_convenio_empresa_search" model="ir.ui.view">
        <field name="name">uprofe.convenio_empresa.search</field>
        <field name="model">uprofe.convenio_empresa</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="estado_convenio_id"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_estado"
                            string="Estado"
                            context="{'group_by': 'estado_convenio_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_uprofe_convenio_empresa" model="ir.actions.act_window">
        <field name="name">Convenios de prácticas</field>
        <field name="res_model">uprofe.convenio_empresa</field>
        <field name="search_view_id" ref="view_uprofe_convenio_empresa_search"/>
        <field name="view_mode">list,form,calendar</field>
    </record>
</odoo>