<odoo>
  <record id="tipo_sesion_form_view" model="ir.ui.view">
    <field name="name">uprofe.tipo_sesion.form</field>
    <field name="model">uprofe.tipo_sesion</field>
    <field name="arch" type="xml">
      <form string="Tipo de sesión">
        <sheet layout="auto">
          <group>
            <field name="idcard" />
          </group>
          <notebook>
            <page name="datos_personales" string="Datos personales">
              <group>
                <field name="name" />
                <field name="photo" widget="image" class="oe_avatar" />
              </group>
            </page>
            <page name="clases" string="Clases">
              <group>
                <field name="classes_ids" widget="one2many" />
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="tipo_sesion_list_view" model="ir.ui.view">
    <field name="name">gym.instructores.list</field>
    <field name="model">gym.instructores</field>
    <field name="arch" type="xml">
      <list string="list_string">
        <field name="idcard" />
        <field name="name" />
      </list>
    </field>
  </record>

  <record id="instructores_list_action" model="ir.actions.act_window">
    <field name="name">Instructores</field>
    <field name="res_model">gym.instructores</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first instructor</p>
    </field>
  </record>
</odoo>