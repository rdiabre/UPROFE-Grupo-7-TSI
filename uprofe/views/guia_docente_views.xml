<odoo>
    <!-- List -->
    <record id="view_guia_docente_list" model="ir.ui.view">
        <field name="name">uprofe.guia_docente.list</field>
        <field name="model">uprofe.guia_docente</field>
        <field name="arch" type="xml">
            <list>
                <field name="asignatura_id"/>
                <field name="sCurso_academico"/>
                <field name="sNombre_fichero"/>
                <field name="bEs_actual"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_guia_docente_form" model="ir.ui.view">
        <field name="name">uprofe.guia_docente.form</field>
        <field name="model">uprofe.guia_docente</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Guía docente">
                            <field name="asignatura_id"/>
                            <field name="sCurso_academico"/>
                            <field name="bEs_actual"/>
                        </group>
                        <group string="Fichero">
                            <!-- filename: al subir el fichero, Odoo guarda su nombre en sNombre_fichero (así se comprueba que es .pdf) -->
                            <field name="binFichero" filename="sNombre_fichero"/>
                            <field name="sNombre_fichero" invisible="1"/>
                        </group>
                    </group>
                    <!-- Vista previa del PDF con el widget pdf_viewer. Solo de lectura y solo cuando la guía ya está guardada (id).
                         Va en un campo aparte (binVista) porque en nuestra versión de Odoo el pdf_viewer no guarda el nombre del fichero -->
                    <group string="Vista previa" invisible="not id">
                        <field name="binVista" widget="pdf_viewer" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_guia_docente_search" model="ir.ui.view">
        <field name="name">uprofe.guia_docente.search</field>
        <field name="model">uprofe.guia_docente</field>
        <field name="arch" type="xml">
            <search>
                <field name="asignatura_id"/>
                <field name="sCurso_academico"/>
                <group expand="0" string="Agrupar por">
                    <filter name="agrupar_asignatura" string="Asignatura" context="{'group_by': 'asignatura_id'}"/>
                    <filter name="agrupar_curso" string="Curso académico" context="{'group_by': 'sCurso_academico'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vista avanzada: gráfico de barras con el número de guías de cada curso académico. Sin type="measure", el gráfico cuenta los registros -->
    <record id="view_guia_docente_graph" model="ir.ui.view">
        <field name="name">uprofe.guia_docente.graph</field>
        <field name="model">uprofe.guia_docente</field>
        <field name="arch" type="xml">
            <graph string="Guías por curso académico" type="bar">
                <field name="sCurso_academico"/>
            </graph>
        </field>
    </record>

    <!-- Action -->
    <record id="guia_docente_list_action" model="ir.actions.act_window">
        <field name="name">Guías docentes</field>
        <field name="res_model">uprofe.guia_docente</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sube la primera guía docente</p>
        </field>
    </record>
</odoo>