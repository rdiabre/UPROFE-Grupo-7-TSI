<odoo>

    <record id="view_incidencia_form" model="ir.ui.view">
        <field name="name">maintenance.request.form.uprofe</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form" />
        <field name="arch" type="xml">

            <field name="name" position="after">
                <field name="sNum_incidencia" required="1" />
                <attribute name="string">Número incidencia</attribute>
            </field>

            <field name="equipment_id" position="attributes">
                <attribute name="string">Objeto inventariable</attribute>
                <attribute name="required">1</attribute>
                <attribute name="domain">[('sTipo_objeto', 'in', ['mobiliario', 'equipo'])]</attribute>
            </field>

            <field name="equipment_id" position="after">
                <field name="fCoste_relacionado" />
            </field>

            <field name="maintenance_team_id" position="replace" />
            <field name="user_id" position="replace" />
            <field name="email_cc" position="replace" />

        </field>
    </record>


    <record id="view_incidencia_list" model="ir.ui.view">
        <field name="name">maintenance.request.list.uprofe</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree" />
        <field name="arch" type="xml">

            <field name="name" position="before">
                <field name="sNum_incidencia" />
            </field>

            <field name="name" position="after">
                <field name="equipment_id" />
            </field>

            <field name="stage_id" position="before">
                <field name="fCoste_relacionado" />
            </field>

            <field name="owner_user_id" position="replace" />
            <field name="user_id" position="replace" />
            <field name="category_id" position="replace" />

        </field>
    </record>

    <record id="view_incidencia_graph" model="ir.ui.view">
        <field name="name">incidencia.graph</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <graph string="Coste de incidencias por etapa" type="bar">
                <field name="stage_id" type="row" />
                <field name="fCoste_relacionado" type="measure" />
            </graph>
        </field>
    </record>


    <record id="action_uprofe_incidencias" model="ir.actions.act_window">
        <field name="name">Incidencias</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">list,form,graph</field>

        <field name="search_view_id"
            ref="maintenance.hr_equipment_request_view_search" />
    </record>

    <record id="action_uprofe_incidencias_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="3" />
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_incidencia_graph" />
        <field name="act_window_id" ref="action_uprofe_incidencias" />
    </record>

</odoo>