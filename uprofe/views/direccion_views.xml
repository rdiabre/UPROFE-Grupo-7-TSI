<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- vista de listas -->
    <record id="view_uprofe_direccion_list" model="ir.ui.view">
        <field name="name">uprofe.direccion.list</field>
        <field name="model">uprofe.direccion</field>
        <field name="arch" type="xml">
            <list string="Direcciones">
                <field name="scod_direccion"/>
                <field name="scalle"/>
                <field name="snumero"/>
                <field name="scod_postal"/>
                <field name="sciudad"/>
            </list>
        </field>
    </record>

    <!-- vista de formulario -->
    <record id="view_uprofe_direccion_form" model="ir.ui.view">
        <field name="name">uprofe.direccion.form</field>
        <field name="model">uprofe.direccion</field>
        <field name="arch" type="xml">
            <form string="Dirección">
                <sheet>
                    <group>
                        <group>
                            <field name="scod_direccion"/>
                            <field name="scalle"/>
                            <field name="snumero"/>
                        </group>
                        <group>
                            <field name="scod_postal"/>
                            <field name="sciudad"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista avanzada -->
    <record id="view_uprofe_direccion_graph" model="ir.ui.view">
        <field name="name">uprofe.direccion.graph</field>
        <field name="model">uprofe.direccion</field>
        <field name="arch" type="xml">
            <graph string="Direcciones por ciudad" type="bar">
                <field name="sciudad"/>
            </graph>
        </field>
    </record>

    <!-- busqueda -->
    <record id="view_uprofe_direccion_search" model="ir.ui.view">
        <field name="name">uprofe.direccion.search</field>
        <field name="model">uprofe.direccion</field>
        <field name="arch" type="xml">
            <search>
                <field name="scod_direccion"/>
                <field name="scalle"/>
                <field name="sciudad"/>
                <field name="scod_postal"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_ciudad" string="Ciudad"
                            context="{'group_by': 'sciudad'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- accion -->
    <record id="action_uprofe_direccion" model="ir.actions.act_window">
        <field name="name">Direcciones</field>
        <field name="res_model">uprofe.direccion</field>
        <field name="search_view_id" ref="view_uprofe_direccion_search"/>
        <field name="view_mode">list,form,graph</field>
    </record>
</odoo>