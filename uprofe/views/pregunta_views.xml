<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista List (Sustituye a la antigua <tree>) -->
    <record id="view_uprofe_pregunta_tree" model="ir.ui.view">
        <field name="name">uprofe.pregunta.list</field>
        <field name="model">uprofe.pregunta</field>
        <field name="arch" type="xml">
            <list string="Preguntas">
                <field name="num_pregunta"/>
                <field name="name"/>
                <field name="tipo_respuesta_id"/>
                <field name="encuesta_id"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="view_uprofe_pregunta_form" model="ir.ui.view">
        <field name="name">uprofe.pregunta.form</field>
        <field name="model">uprofe.pregunta</field>
        <field name="arch" type="xml">
            <form string="Pregunta">
                <sheet>
                    <group>
                        <group>
                            <field name="num_pregunta"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="tipo_respuesta_id"/>
                            <field name="encuesta_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana (Cambia tree por list) -->
    <record id="action_uprofe_pregunta" model="ir.actions.act_window">
        <field name="name">Preguntas</field>
        <field name="res_model">uprofe.pregunta</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Entrada del Menú para Preguntas -->
    <menuitem id="menu_uprofe_pregunta_item" 
              name="Preguntas" 
              parent="uprofe_menu_pregunta" 
              action="action_uprofe_pregunta" 
              sequence="10"/>
</odoo>