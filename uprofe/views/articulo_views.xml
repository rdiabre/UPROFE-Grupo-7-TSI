<odoo>
    <record id="uprofe_articulo_graph_view" model="ir.ui.view">
        <field name="name">uprofe.articulo.graph</field>
        <field name="model">uprofe.articulo</field>
        <field name="arch" type="xml">
            <graph string="Artículos por revista" type="bar">
                <field name="sRevista"/>
            </graph>
        </field>
    </record>

    <record id="uprofe_articulo_form_view" model="ir.ui.view">
        <field name="name">uprofe.articulo.form</field>
        <field name="model">uprofe.articulo</field>
        <field name="arch" type="xml">
            <form string="Artículo">
                <sheet>
                    <group>
                        <group string="Datos de la publicación">
                            <field name="name"/>
                            <field name="sTitulo"/>
                            <field name="dFecha_publicacion"/>
                        </group>
                        <group string="Datos del artículo">
                            <field name="sRevista"/>
                            <field name="sDoi"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Autores">
                            <group>
                                <field name="profesor_ids" widget="many2many_tags"/>
                                <!--Descomentar cuando esté el modelo investigador-->
                                <!--<field name="investigador_ids" widget="many2many_tags"/>-->
                            </group>
                        </page>
                        <page string="Proyecto">
                            <field name="proyecto_investigacion_id"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="uprofe_articulo_list_view" model="ir.ui.view">
        <field name="name">uprofe.articulo.list</field>
        <field name="model">uprofe.articulo</field>
        <field name="arch" type="xml">
            <list string="Artículos">
                <field name="name"/>
                <field name="sTitulo"/>
                <field name="sRevista"/>
                <field name="dFecha_publicacion"/>
                <field name="sDoi"/>
            </list>
        </field>
    </record>

    <record id="articulo_list_action" model="ir.actions.act_window">
        <field name="name">Artículos</field>
        <field name="res_model">uprofe.articulo</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Añade el primer artículo</p>
        </field>
    </record>
</odoo>