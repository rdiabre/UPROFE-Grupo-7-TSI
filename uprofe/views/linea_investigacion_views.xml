<odoo>
    <record id="uprofe_linea_investigacion_form_view" model="ir.ui.view">
        <field name="name">uprofe.linea_investigacion.form</field>
        <field name="model">uprofe.linea_investigacion</field>
        <field name="arch" type="xml">
            <form string="Líneas de investigación">
                <sheet layout="auto">
                    <group>
                        <field name="sName" />
                        <field name="sNombre" />
                        <field name="sDescripcion" />
                        <field name="iGrupo_inv_id" widget="many2one" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="uprofe_linea_investigacion_list_view" model="ir.ui.view">
        <field name="name">uprofe.linea_investigacion.list</field>
        <field name="model">uprofe.linea_investigacion</field>
        <field name="arch" type="xml">
            <list string="Lista de líneas de investigación">
                <field name="sName" />
                <field name="sNombre" />
                <field name="sDescripcion" />
                <field name="iGrupo_inv_id" widget="many2one" />
            </list>
        </field>
    </record>

    <record id="linea_investigacion_list_action" model="ir.actions.act_window">
        <field name="name">Líneas de investigación</field>
        <field name="res_model">uprofe.linea_investigacion</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Añade la primera línea de investigación</p>
        </field>
    </record>
</odoo>