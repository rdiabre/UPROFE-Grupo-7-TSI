<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Catálogos de movilidad: país, ciudad, idioma, nivel de estudios y los 3 estados.
         Todos heredan de uprofe.catalogo_mixin: secuencia (se reordena arrastrando con
         widget="handle"), archivado (campo active) y nº de usos.
         Los menús están en menu.xml. -->

    <!-- ============================== PAÍS ============================== -->
    <record id="view_uprofe_pais_list" model="ir.ui.view">
        <field name="name">uprofe.pais.list</field>
        <field name="model">uprofe.pais</field>
        <field name="arch" type="xml">
            <list>
                <field name="iSecuencia" widget="handle"/>
                <field name="sName"/>
                <field name="sCodigo_iso"/>
                <field name="bUnion_europea"/>
                <field name="iNum_usos" string="Nº de ciudades"/>
                <field name="iNum_universidades"/>
            </list>
        </field>
    </record>

    <record id="view_uprofe_pais_form" model="ir.ui.view">
        <field name="name">uprofe.pais.form</field>
        <field name="model">uprofe.pais</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="sName"/>
                        <h1><field name="sName" placeholder="Por ejemplo, Italia"/></h1>
                    </div>
                    <group>
                        <group string="Datos del país">
                            <field name="sCodigo_iso" placeholder="IT"/>
                            <field name="bUnion_europea"/>
                            <field name="sDescription"/>
                        </group>
                        <group string="Uso">
                            <field name="iNum_usos" string="Nº de ciudades"/>
                            <field name="iNum_universidades"/>
                            <field name="iSecuencia"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ciudades">
                            <field name="ciudad_ids">
                                <list>
                                    <field name="sName"/>
                                    <field name="iPoblacion"/>
                                    <field name="bCapital"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_uprofe_pais_kanban" model="ir.ui.view">
        <field name="name">uprofe.pais.kanban</field>
        <field name="model">uprofe.pais</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="sName" class="fw-bold fs-5"/>
                            <field name="sCodigo_iso" class="badge text-bg-secondary"/>
                        </div>
                        <div><field name="iNum_usos"/> ciudades · <field name="iNum_universidades"/> universidades</div>
                        <div invisible="not bUnion_europea" class="text-success">Unión Europea</div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_uprofe_pais_search" model="ir.ui.view">
        <field name="name">uprofe.pais.search</field>
        <field name="model">uprofe.pais</field>
        <field name="arch" type="xml">
            <search>
                <field name="sName"/>
                <field name="sCodigo_iso"/>
                <filter string="Unión Europea" name="ue" domain="[('bUnion_europea', '=', True)]"/>
                <filter string="Fuera de la UE" name="no_ue" domain="[('bUnion_europea', '=', False)]"/>
                <separator/>
                <filter string="Archivados" name="archivados" domain="[('active', '=', False)]"/>
                <group string="Agrupar por">
                    <filter string="Unión Europea" name="group_ue" context="{'group_by': 'bUnion_europea'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_uprofe_pais" model="ir.actions.act_window">
        <field name="name">Países</field>
        <field name="res_model">uprofe.pais</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <!-- ============================== CIUDAD ============================== -->
    <record id="view_uprofe_ciudad_list" model="ir.ui.view">
        <field name="name">uprofe.ciudad.list</field>
        <field name="model">uprofe.ciudad</field>
        <field name="arch" type="xml">
            <list>
                <field name="iSecuencia" widget="handle"/>
                <field name="sName"/>
                <field name="pais_id"/>
                <field name="bCapital"/>
                <field name="iPoblacion"/>
                <field name="iNum_usos" string="Nº de universidades"/>
                <field name="sDescription" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_uprofe_ciudad_form" model="ir.ui.view">
        <field name="name">uprofe.ciudad.form</field>
        <field name="model">uprofe.ciudad</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="sName"/>
                        <h1><field name="sName" placeholder="Por ejemplo, Bolonia"/></h1>
                    </div>
                    <group>
                        <group string="Datos de la ciudad">
                            <field name="pais_id"/>
                            <field name="bCapital"/>
                            <field name="iPoblacion"/>
                            <field name="sDescription"/>
                        </group>
                        <group string="Uso">
                            <field name="iNum_usos" string="Nº de universidades"/>
                            <field name="iSecuencia"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Universidades">
                            <field name="universidad_ids">
                                <list>
                                    <field name="cod_erasmus"/>
                                    <field name="sName"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_uprofe_ciudad_search" model="ir.ui.view">
        <field name="name">uprofe.ciudad.search</field>
        <field name="model">uprofe.ciudad</field>
        <field name="arch" type="xml">
            <search>
                <field name="sName"/>
                <field name="pais_id"/>
                <filter string="Capitales" name="capitales" domain="[('bCapital', '=', True)]"/>
                <filter string="Más de un millón de habitantes" name="grandes" domain="[('iPoblacion', '&gt;', 1000000)]"/>
                <separator/>
                <filter string="Archivadas" name="archivados" domain="[('active', '=', False)]"/>
                <group string="Agrupar por">
                    <filter string="País" name="group_pais" context="{'group_by': 'pais_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Graph: número de ciudades registradas por país -->
    <record id="view_uprofe_ciudad_graph" model="ir.ui.view">
        <field name="name">uprofe.ciudad.graph</field>
        <field name="model">uprofe.ciudad</field>
        <field name="arch" type="xml">
            <graph string="Ciudades por país" type="bar">
                <field name="pais_id"/>
            </graph>
        </field>
    </record>

    <!-- Kanban (cards): la ciudad no tiene fechas, así que en lugar de Calendar se muestran tarjetas -->
    <record id="view_uprofe_ciudad_kanban" model="ir.ui.view">
        <field name="name">uprofe.ciudad.kanban</field>
        <field name="model">uprofe.ciudad</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="sName" class="fw-bold fs-5"/>
                        <div>País: <field name="pais_id"/></div>
                        <div invisible="not bCapital" class="text-primary">Capital</div>
                        <field name="sDescription" class="text-muted"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_uprofe_ciudad" model="ir.actions.act_window">
        <field name="name">Ciudades</field>
        <field name="res_model">uprofe.ciudad</field>
        <field name="view_mode">list,form,graph,kanban</field>
    </record>

    <!-- ============================== IDIOMA ============================== -->
    <record id="view_uprofe_idioma_list" model="ir.ui.view">
        <field name="name">uprofe.idioma.list</field>
        <field name="model">uprofe.idioma</field>
        <field name="arch" type="xml">
            <list>
                <field name="iSecuencia" widget="handle"/>
                <field name="sName"/>
                <field name="sCodigo"/>
                <field name="iNum_universidades"/>
                <field name="iNum_plazas"/>
                <field name="iNum_asignaturas"/>
            </list>
        </field>
    </record>

    <record id="view_uprofe_idioma_form" model="ir.ui.view">
        <field name="name">uprofe.idioma.form</field>
        <field name="model">uprofe.idioma</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="sName"/>
                        <h1><field name="sName" placeholder="Por ejemplo, Inglés"/></h1>
                    </div>
                    <group>
                        <group string="Datos del idioma">
                            <field name="sCodigo" placeholder="en"/>
                            <field name="iSecuencia"/>
                        </group>
                        <group string="Uso">
                            <field name="iNum_universidades"/>
                            <field name="iNum_plazas"/>
                            <field name="iNum_asignaturas"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Universidades que lo imparten">
                            <field name="universidad_ids" widget="many2many">
                                <list>
                                    <field name="sName"/>
                                    <field name="pais_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Plazas">
                            <field name="plaza_erasmus_ids" readonly="1"/>
                        </page>
                        <page string="Asignaturas">
                            <field name="asignatura_destino_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_uprofe_idioma_kanban" model="ir.ui.view">
        <field name="name">uprofe.idioma.kanban</field>
        <field name="model">uprofe.idioma</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="sName" class="fw-bold fs-5"/>
                            <field name="sCodigo" class="badge text-bg-secondary"/>
                        </div>
                        <div><field name="iNum_universidades"/> universidades · <field name="iNum_plazas"/> plazas</div>
                        <div><field name="iNum_asignaturas"/> asignaturas</div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_uprofe_idioma_search" model="ir.ui.view">
        <field name="name">uprofe.idioma.search</field>
        <field name="model">uprofe.idioma</field>
        <field name="arch" type="xml">
            <search>
                <field name="sName"/>
                <field name="sCodigo"/>
                <field name="universidad_ids"/>
                <filter string="Con plazas" name="con_plazas" domain="[('plaza_erasmus_ids', '!=', False)]"/>
                <filter string="Con asignaturas" name="con_asignaturas" domain="[('asignatura_destino_ids', '!=', False)]"/>
                <separator/>
                <filter string="Archivados" name="archivados" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_uprofe_idioma" model="ir.actions.act_window">
        <field name="name">Idiomas</field>
        <field name="res_model">uprofe.idioma</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

