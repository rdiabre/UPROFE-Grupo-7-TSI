        <field name="model">uprofe.estado_la_linea</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="sName"/>
                        <h1><field name="sName" placeholder="Por ejemplo, convalidada"/></h1>
                    </div>
                    <group>
                        <group string="Comportamiento">
                            <field name="bInicial"/>
                            <field name="bFinal"/>
                            <field name="iColor" widget="color_picker"/>
                            <field name="iSecuencia"/>
                        </group>
                        <group string="Uso">
                            <field name="iNum_usos" string="Nº de líneas"/>
                            <field name="fCreditos_total"/>
                        </group>
                    </group>
                    <field name="sDescripcion" placeholder="Descripción del estado"/>
                    <notebook>
                        <page string="Líneas">
                            <field name="linea_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_uprofe_estado_la_linea_kanban" model="ir.ui.view">
        <field name="name">uprofe.estado_la_linea.kanban</field>
        <field name="model">uprofe.estado_la_linea</field>
        <field name="arch" type="xml">
            <kanban highlight_color="iColor">
                <templates>
                    <t t-name="card">
                        <field name="sName" class="fw-bold fs-5"/>
                        <field name="sDescripcion" class="text-muted"/>
                        <div><field name="iNum_usos"/> líneas · <field name="fCreditos_total"/> créditos</div>
                        <div invisible="not bInicial" class="text-primary">Estado inicial</div>
                        <div invisible="not bFinal" class="text-danger">Estado final</div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_uprofe_estado_la_linea_search" model="ir.ui.view">
        <field name="name">uprofe.estado_la_linea.search</field>
        <field name="model">uprofe.estado_la_linea</field>
        <field name="arch" type="xml">
            <search>
                <field name="sName"/>
                <field name="sDescripcion"/>
                <filter string="Inicial" name="inicial" domain="[('bInicial', '=', True)]"/>
                <filter string="Finales" name="finales" domain="[('bFinal', '=', True)]"/>
                <separator/>
                <filter string="Archivados" name="archivados" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_uprofe_estado_la_linea" model="ir.actions.act_window">
        <field name="name">Estados de línea</field>
        <field name="res_model">uprofe.estado_la_linea</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
</odoo>
