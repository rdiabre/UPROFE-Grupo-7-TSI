                <separator/>
                <filter string="Archivados" name="archivados" domain="[('active', '=', False)]"/>
                <group string="Agrupar por">
                    <filter string="Duración" name="group_duracion" context="{'group_by': 'iDuracion_anios'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_uprofe_nivel_estudios" model="ir.actions.act_window">
        <field name="name">Niveles de estudio</field>
        <field name="res_model">uprofe.nivel_estudios</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

