<odoo>

    <record id="view_objeto_inventariable_form" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.uprofe</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form" />
        <field name="arch" type="xml">

            <field name="category_id" position="after">
                <field name="sTipo_objeto" />
                <field name="sEstado" />
            </field>
            <field name="maintenance_team_id" position="replace"/>
            <field name="technician_user_id" position="replace"/>
            <field name="assign_date" position="replace"/>
            <field name="owner_user_id" position="replace"/>
            <field name="partner_id" position="replace"/>
            <field name="partner_ref" position="replace"/>
            <field name="category_id" position="attributes"> 
                <field name="string">Categoría</field>
            </field>
        </field>
    </record>

    <record id="view_objeto_inventariable_list" model="ir.ui.view">
        <field name="name">maintenance.equipment.list.uprofe</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree" />
        <field name="arch" type="xml">

            <field name="name" position="after">
                <field name="sTipo_objeto" />
                <field name="sEstado" />
            </field>

        </field>
    </record>

    <record id="action_uprofe_equipos" model="ir.actions.act_window">
        <field name="name">Objetos de inventario</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sTipo_objeto', '=', 'equipo')]</field>
        <field name="context">{'default_sTipo_objeto': 'equipo'}</field>
    </record>

</odoo>