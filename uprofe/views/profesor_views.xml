<odoo>
    <!-- List -->
    <record id="view_profesor_list" model="ir.ui.view">
        <field name="name">uprofe.profesor.list</field>
        <field name="model">uprofe.profesor</field>
        <field name="arch" type="xml">
            <list>
                <field name="sDni"/>
                <field name="name" string="Nombre"/>
                <field name="sApellidos"/>
                <field name="email" string="Correo electrónico"/>
                <field name="sDespacho"/>
                <!-- <field name="tipo_sesion_ids" widget="many2many_tags"/> VA EN EL PR DE SESION -->
                <field name="bDoctor"/>
                <field name="bTutor_interno"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_profesor_form" model="ir.ui.view">
        <field name="name">uprofe.profesor.form</field>
        <field name="model">uprofe.profesor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <!-- Herencia de Persona -->
                        <group string="Datos personales">
                            <!-- Oculto. Si el DNI existe ya porque está registrada la persona, se rellena  -->
                            <field name="sDni"/>
                            <field name="persona_id" invisible="1"/>
                            <field name="name" string="Nombre"/>
                            <field name="sApellidos"/>
                            <field name="email" string="Correo electrónico" required="1"/>
                            <field name="phone" string="Teléfono" required="1"/>
                        </group>
                        <!-- Campos propios -->
                        <group string="Datos del profesor">
                            <!-- <field name="tipo_sesion_ids" widget="many2many_tags"/> VA EN EL PR DE SESION -->
                            <field name="sDespacho"/>
                            <field name="bDoctor"/>
                            <field name="bTutor_interno"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_profesor_search" model="ir.ui.view">
        <field name="name">uprofe.profesor.search</field>
        <field name="model">uprofe.profesor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Nombre"/>
                <field name="sApellidos"/>
                <field name="sDni"/>
                <field name="sDespacho"/>
                <filter name="filtro_doctor" string="Doctores" domain="[('bDoctor', '=', True)]"/>
                <filter name="filtro_tutor_interno" string="Tutores internos" domain="[('bTutor_interno', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="profesor_list_action" model="ir.actions.act_window">
        <field name="name">Profesores</field>
        <field name="res_model">uprofe.profesor</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer profesor</p>
        </field>
    </record>
</odoo>