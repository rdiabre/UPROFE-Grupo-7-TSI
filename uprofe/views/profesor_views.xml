<odoo>
    <!-- List -->
    <record id="view_profesor_list" model="ir.ui.view">
        <field name="name">uprofe.profesor.list</field>
        <field name="model">uprofe.profesor</field>
        <field name="arch" type="xml">
            <list>
                <field name="sDni"/>
                <field name="name" string="Nombre"/>
                <field name="sApellidos"/>
                <field name="email" string="Correo electrónico"/>
                <field name="sDespacho"/>
                <field name="tipo_sesion_ids" widget="many2many_tags"/>
                <field name="bDoctor"/>
                <field name="bTutor_interno"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_profesor_form" model="ir.ui.view">
        <field name="name">uprofe.profesor.form</field>
        <field name="model">uprofe.profesor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <!-- Herencia de Persona -->
                        <group string="Datos personales">
                            <!-- Si la persona ya existe, se elige aquí y se rellenan sus datos. Si no, se deja vacío y se crea al guardar -->
                            <field name="persona_id" string="Persona existente" required="0"/>
                            <field name="sDni"/>
                            <field name="name" string="Nombre"/>
                            <field name="sApellidos"/>
                            <field name="email" string="Correo electrónico" required="1"/>
                            <field name="phone" string="Teléfono" required="1"/>
                        </group>
                        <!-- Campos propios -->
                        <group string="Datos del profesor">
                            <field name="tipo_sesion_ids" widget="many2many_tags"/>
                            <field name="sDespacho"/>
                            <field name="bDoctor"/>
                            <field name="bTutor_interno"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_profesor_search" model="ir.ui.view">
        <field name="name">uprofe.profesor.search</field>
        <field name="model">uprofe.profesor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Nombre"/>
                <field name="sApellidos"/>
                <field name="sDni"/>
                <field name="sDespacho"/>
                <filter name="filtro_doctor" string="Doctores" domain="[('bDoctor', '=', True)]"/>
                <filter name="filtro_tutor_interno" string="Tutores internos" domain="[('bTutor_interno', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Vista avanzada: tabla dinámica (pivot). Cuenta los profesores cruzando si son
    doctores (filas) y si son tutores internos (columnas). Desde la propia vista se puede
    cambiar la agrupación (por ejemplo, por despacho) y descargar la tabla en Excel -->
    <record id="view_profesor_pivot" model="ir.ui.view">
        <field name="name">uprofe.profesor.pivot</field>
        <field name="model">uprofe.profesor</field>
        <field name="arch" type="xml">
            <pivot string="Profesores">
                <field name="selDoctor" type="row"/>
                <field name="selTutor_interno" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Action -->
    <record id="profesor_list_action" model="ir.actions.act_window">
        <field name="name">Profesores</field>
        <field name="res_model">uprofe.profesor</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer profesor</p>
        </field>
    </record>
</odoo>