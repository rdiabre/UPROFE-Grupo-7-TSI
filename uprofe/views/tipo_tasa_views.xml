<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- vbista de listas -->
    <record id="view_uprofe_tipo_tasa_list" model="ir.ui.view">
        <field name="name">uprofe.tipo_tasa.list</field>
        <field name="model">uprofe.tipo_tasa</field>
        <field name="arch" type="xml">
            <list string="Tipos de tasa">
                <field name="stipo"/>
            </list>
        </field>
    </record>

    <!-- vista de formulario -->
    <record id="view_uprofe_tipo_tasa_form" model="ir.ui.view">
        <field name="name">uprofe.tipo_tasa.form</field>
        <field name="model">uprofe.tipo_tasa</field>
        <field name="arch" type="xml">
            <form string="Tipo de tasa">
                <sheet>
                    <group>
                        <field name="stipo"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista avanzada -->
    <record id="view_uprofe_tipo_tasa_kanban" model="ir.ui.view">
        <field name="name">uprofe.tipo_tasa.kanban</field>
        <field name="model">uprofe.tipo_tasa</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="stipo" class="fw-bold fs-5"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- accion -->
    <record id="action_uprofe_tipo_tasa" model="ir.actions.act_window">
        <field name="name">Tipos de tasa</field>
        <field name="res_model">uprofe.tipo_tasa</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
</odoo>