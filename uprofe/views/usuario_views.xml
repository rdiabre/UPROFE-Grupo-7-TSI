<odoo>
    <record id="uprofe_usuario_form_view" model="ir.ui.view">
        <field name="name">uprofe.usuario.form</field>
        <field name="model">uprofe.usuario</field>
        <field name="arch" type="xml">
            <form string="Usuarios">
                <sheet layout="auto">
                    <field name="binFoto" widget="image" class="oe_avatar"/>
                    <group>
                        <field name="sName" />
                        <field name="sCorreo" />
                        <field name="sContrasena" password="True" />
                        <field name="sRepetir_contrasena" password="True" />
                        <field name="bEstado_cuenta" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="uprofe_usuario_list_view" model="ir.ui.view">
        <field name="name">uprofe.usuario.list</field>
        <field name="model">uprofe.usuario</field>
        <field name="arch" type="xml">
            <list string="Lista de usuarios">
                <field name="binFoto" widget="image" options="{'size': [30, 30]}" />
                <field name="sName" />
                <field name="sCorreo" />
                <field name="bEstado_cuenta" />
                <field name="dUltimo_acceso" />
            </list>
        </field>
    </record>

    <record id="usuario_list_action" model="ir.actions.act_window">
        <field name="name">Usuarios</field>
        <field name="res_model">uprofe.usuario</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primero usuario</p>
        </field>
    </record>
</odoo>