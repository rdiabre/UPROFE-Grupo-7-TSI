<odoo>
    <record id="uprofe_usuario_search" model="ir.ui.view">
        <field name="name">uprofe.usuario.search</field>
        <field name="model">uprofe.usuario</field>
        <field name="arch" type="xml">
            <search>
            <field name="name" string="Nombre de usuario"/>
            <field name="login" string="Correo"/>
            <field name="profesor_id"/>
            <field name="alumno_id"/>

            <filter name="activos" string="Activos" domain="[('active', '=', True)]"/>
            <filter name="archivados" string="Archivados" domain="[('active', '=', False)]"/>
            <filter name="sin_acceso" string="Nunca han entrado" domain="[('login_date', '=', False)]"/>
        </search>
        </field>
    </record>

    <record id="uprofe_usuario_form" model="ir.ui.view">
        <field name="name">uprofe.usuario.form</field>
        <field name="model">uprofe.usuario</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" string="Foto de perfil"/>
                    <group>
                        <group string="Datos de la cuenta">
                            <field name="name" string="Nombre de usuario"/>
                            <field name="login" string="Correo electrónico"/>
                            <field name="active" string="Activo"/>
                        </group>
                        <group string="Seguridad">
                            <field name="password" password="True" string="Contraseña" required="not id"/> <!--Requerido solo cuando se está creando el usuario, si ya está creado no es obligatorio-->
                            <field name="login_date" string="Último acceso" readonly="1"/>
                        </group>
                    </group>

                    <!-- Selectores para cambiar el profesor o alumno asociado -->
                    <group string="Persona asociada">
                        <field name="profesor_id" readonly="alumno_id" domain="[('usuario_id', '=', False)]" options="{'no_create': True}"/>
                        <!-- <field name="alumno_id" readonly="profesor_id" domain="[('usuario_id', '=', False)]" options="{'no_create': True}"/> -->
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="uprofe_usuario_list_view" model="ir.ui.view">
        <field name="name">uprofe.usuario.list</field>
        <field name="model">uprofe.usuario</field>
        <field name="arch" type="xml">
            <list string="Lista usuarios">
                <field name="image_128" widget="image" options="{'size': [32, 32]}" string="Foto"/>
                <field name="name" />
                <field name="login" />
                <field name="active" />
                <field name="login_date" />
            </list>
        </field>
    </record>

    <record id="usuario_list_action" model="ir.actions.act_window">
        <field name="name">Usuarios</field>
        <field name="res_model">uprofe.usuario</field>
        <field name="view_mode">list,form,search</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Añade el primer usuario</p>
        </field>
    </record>
</odoo>