<odoo>
    <!-- Vista de lista -->
    <record id="view_persona_list" model="ir.ui.view">
        <field name="name">uprofe.persona.list</field>
        <field name="model">uprofe.persona</field>
        <field name="arch" type="xml">
            <list>
                <field name="dni"/>
                <field name="name"/>
                <field name="apellidos"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="view_persona_form" model="ir.ui.view">
        <field name="name">uprofe.persona.form</field>
        <field name="model">uprofe.persona</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Nombre"/>
                            <field name="apellidos"/>
                            <field name="dni"/>
                        </group>
                        <group>
                            <field name="email" string="Correo electrónico"/>
                            <field name="phone" string="Teléfono"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Búsqueda -->
    <record id="view_persona_search" model="ir.ui.view">
        <field name="name">uprofe.persona.search</field>
        <field name="model">uprofe.persona</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Nombre"/>
                <field name="apellidos"/>
                <field name="dni"/>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="persona_list_action" model="ir.actions.act_window">
        <field name="name">Personas</field>
        <field name="res_model">uprofe.persona</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea la primera persona</p>
        </field>
    </record>

    <!-- Menú: cuelga del menú uprofe_menu -->
    <menuitem name="Personas" id="persona_menu" parent="uprofe_menu"
              groups="group_uprofe_manager" action="persona_list_action"/>
</odoo>