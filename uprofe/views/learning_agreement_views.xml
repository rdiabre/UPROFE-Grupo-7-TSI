<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Lista -->
    <record id="view_uprofe_learning_agreement_list" model="ir.ui.view">
        <field name="name">uprofe.learning_agreement.list</field>
        <field name="model">uprofe.learning_agreement</field>
        <field name="arch" type="xml">
            <list>
                <field name="sNum_la"/>
                <field name="movilidad_id"/>
                <field name="iVersion"/>
                <field name="estado_id"/>
                <field name="dFecha_firma"/>
            </list>
        </field>
    </record>

    <!-- Formulario -->
    <record id="view_uprofe_learning_agreement_form" model="ir.ui.view">
        <field name="name">uprofe.learning_agreement.form</field>
        <field name="model">uprofe.learning_agreement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Datos generales">
                            <field name="sNum_la"/>
                            <field name="iVersion"/>
                            <field name="dFecha_firma"/>
                        </group>
                        <group string="Movilidad y estado">
                            <field name="movilidad_id"/>
                            <field name="estado_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas">
                            <field name="linea_ids">
                                <list editable="bottom">
                                    <field name="iNum_linea"/>
                                    <field name="asignatura_destino_id"/>
                                    <field name="estado_id"/>
                                    <field name="fNota"/>
                                    <field name="fCreditos_reconocidos"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Búsqueda y filtros -->
    <record id="view_uprofe_learning_agreement_search" model="ir.ui.view">
        <field name="name">uprofe.learning_agreement.search</field>
        <field name="model">uprofe.learning_agreement</field>
        <field name="arch" type="xml">
            <search>
                <field name="sNum_la"/>
                <field name="movilidad_id"/>
                <field name="estado_id"/>
                <group string="Agrupar por">
                    <filter string="Movilidad" name="group_movilidad" context="{'group_by': 'movilidad_id'}"/>
                    <filter string="Estado" name="group_estado" context="{'group_by': 'estado_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_uprofe_learning_agreement" model="ir.actions.act_window">
        <field name="name">Learning agreements</field>
        <field name="res_model">uprofe.learning_agreement</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú: cuelga de "Movilidad", definido en catalogos_views.xml -->
    <menuitem id="menu_uprofe_learning_agreement"
              name="Learning agreements"
              parent="menu_uprofe_movilidad"
              action="action_uprofe_learning_agreement"
              sequence="50"/>

</odoo>