<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Lista -->
    <record id="view_uprofe_movilidad_list" model="ir.ui.view">
        <field name="name">uprofe.movilidad.list</field>
        <field name="model">uprofe.movilidad</field>
        <field name="arch" type="xml">
            <list>
                <field name="sNum_movilidad"/>
                <field name="dFecha_inicio"/>
                <field name="dFecha_fin"/>
                <field name="estado_id"/>
            </list>
        </field>
    </record>

    <!-- Formulario -->
    <record id="view_uprofe_movilidad_form" model="ir.ui.view">
        <field name="name">uprofe.movilidad.form</field>
        <field name="model">uprofe.movilidad</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Datos generales">
                            <field name="sNum_movilidad"/>
                            <field name="estado_id"/>
                        </group>
                        <group string="Periodo de la estancia">
                            <field name="dFecha_inicio"/>
                            <field name="dFecha_fin"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Learning agreements">
                            <field name="learning_agreement_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Búsqueda y filtros -->
    <record id="view_uprofe_movilidad_search" model="ir.ui.view">
        <field name="name">uprofe.movilidad.search</field>
        <field name="model">uprofe.movilidad</field>
        <field name="arch" type="xml">
            <search>
                <field name="sNum_movilidad"/>
                <field name="estado_id"/>
                <group string="Agrupar por">
                    <filter string="Estado" name="group_estado" context="{'group_by': 'estado_id'}"/>
                    <filter string="Mes de inicio" name="group_inicio" context="{'group_by': 'dFecha_inicio:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_uprofe_movilidad" model="ir.actions.act_window">
        <field name="name">Movilidades</field>
        <field name="res_model">uprofe.movilidad</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú: cuelga de "Movilidad", definido en catalogos_views.xml.
         El id es menu_uprofe_movilidad_mov para no chocar con el menú padre. -->
    <menuitem id="menu_uprofe_movilidad_mov"
              name="Movilidades"
              parent="menu_uprofe_movilidad"
              action="action_uprofe_movilidad"
              sequence="40"/>

</odoo>