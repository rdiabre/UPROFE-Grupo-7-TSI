<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Lista -->
    <record id="view_uprofe_universidad_destino_list" model="ir.ui.view">
        <field name="name">uprofe.universidad_destino.list</field>
        <field name="model">uprofe.universidad_destino</field>
        <field name="arch" type="xml">
            <list>
                <field name="cod_erasmus"/>
                <field name="sName"/>
                <!-- Descomentar cuando exista Ciudad -->
                <!-- <field name="ciudad_id"/> -->
                <!-- <field name="pais_id"/> -->
            </list>
        </field>
    </record>

    <!-- Formulario -->
    <record id="view_uprofe_universidad_destino_form" model="ir.ui.view">
        <field name="name">uprofe.universidad_destino.form</field>
        <field name="model">uprofe.universidad_destino</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Datos generales">
                            <field name="sName"/>
                            <field name="cod_erasmus"/>
                        </group>
                        <!-- Descomentar cuando exista Ciudad -->
                        <!-- <group string="Ubicación">
                            <field name="ciudad_id"/>
                            <field name="pais_id"/>
                        </group> -->
                    </group>
                    <!-- Descomentar cuando existan Convenio, PlazaErasmus y AsignaturaDestino -->
                    <!-- <notebook>
                        <page string="Convenios">
                            <field name="convenio_ids"/>
                        </page>
                        <page string="Plazas">
                            <field name="plaza_ids"/>
                        </page>
                        <page string="Asignaturas">
                            <field name="asignatura_ids"/>
                        </page>
                    </notebook> -->
                </sheet>
            </form>
        </field>
    </record>

    <!-- Graph: universidades dadas de alta por mes.
         Cuando exista Ciudad se puede agrupar por pais_id / ciudad_id. -->
    <record id="view_uprofe_universidad_destino_graph" model="ir.ui.view">
        <field name="name">uprofe.universidad_destino.graph</field>
        <field name="model">uprofe.universidad_destino</field>
        <field name="arch" type="xml">
            <graph string="Universidades de destino por mes de alta" type="bar">
                <field name="create_date" interval="month"/>
                <!-- <field name="pais_id"/> -->
            </graph>
        </field>
    </record>

    <!-- Calendar: la tabla no tiene campos de fecha propios, así que se usa
         la fecha de alta del registro (create_date, campo automático de Odoo) -->
    <record id="view_uprofe_universidad_destino_calendar" model="ir.ui.view">
        <field name="name">uprofe.universidad_destino.calendar</field>
        <field name="model">uprofe.universidad_destino</field>
        <field name="arch" type="xml">
            <calendar string="Altas de universidades de destino"
                      date_start="create_date"
                      mode="month"
                      quick_create="0">
                <field name="sName"/>
                <field name="cod_erasmus"/>
                <!-- <field name="ciudad_id"/> -->
            </calendar>
        </field>
    </record>

    <!-- Búsqueda y filtros -->
    <record id="view_uprofe_universidad_destino_search" model="ir.ui.view">
        <field name="name">uprofe.universidad_destino.search</field>
        <field name="model">uprofe.universidad_destino</field>
        <field name="arch" type="xml">
            <search>
                <field name="sName"/>
                <field name="cod_erasmus"/>
                <!-- Descomentar cuando exista Ciudad -->
                <!-- <field name="ciudad_id"/> -->
                <!-- <field name="pais_id"/> -->
                <!-- <group string="Agrupar por">
                    <filter string="País" name="group_pais" context="{'group_by': 'pais_id'}"/>
                    <filter string="Ciudad" name="group_ciudad" context="{'group_by': 'ciudad_id'}"/>
                </group> -->
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_uprofe_universidad_destino" model="ir.actions.act_window">
        <field name="name">Universidades de destino</field>
        <field name="res_model">uprofe.universidad_destino</field>
        <field name="view_mode">list,form,graph,calendar</field>
    </record>

    <!-- Menú: cuelga de "Movilidad", definido en catalogos_views.xml -->
    <menuitem id="menu_uprofe_universidad_destino"
              name="Universidades"
              parent="menu_uprofe_movilidad"
              action="action_uprofe_universidad_destino"
              sequence="10"/>

</odoo>
