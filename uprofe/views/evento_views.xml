<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VISTA FORM -->
    <record id="view_evento_form" model="ir.ui.view">
        <field name="name">uprofe.evento.form</field>
        <field name="model">uprofe.evento</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="sTitulo" placeholder="Título del evento..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sCodEvento"/>
                            <!-- <field name="tipo_evento_id"/> -->
                            <field name="iAforo"/>
                        </group>
                        <group>
                            <field name="dFecha"/>
                            <field name="fHoraIni" widget="float_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción">
                            <field name="sDescripcion"/>
                        </page>
                        <page string="Inscripciones">
                            <field name="inscripcion_ids">
                                <list editable="bottom">
                                    <!-- <field name="persona_id"/> -->
                                    <field name="estado"/>
                                    <field name="asiste"/>
                                    <field name="fecha_inscripcion"/>
                                </list>
                            </field>
                        </page>
                        <!-- Pestañas preparadas para cuando existan las relaciones
                        <page string="Organizadores">
                            <field name="organiza_persona_ids"/>
                        </page>
                        <page string="Ponentes">
                            <field name="imparte_persona_ids"/>
                        </page>
                        -->
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VISTA LIST -->
    <record id="view_evento_list" model="ir.ui.view">
        <field name="name">uprofe.evento.list</field>
        <field name="model">uprofe.evento</field>
        <field name="arch" type="xml">
            <list>
                <field name="sCodEvento"/>
                <field name="sTitulo"/>
                <!-- <field name="tipo_evento_id"/> -->
                <field name="dFecha"/>
                <field name="fHoraIni" widget="float_time"/>
                <field name="iAforo"/>
            </list>
        </field>
    </record>

    <!-- VISTA KANBAN -->
    <record id="view_evento_kanban" model="ir.ui.view">
        <field name="name">uprofe.evento.kanban</field>
        <field name="model">uprofe.evento</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="sTitulo"/>
                <field name="dFecha"/>
                <!-- <field name="tipo_evento_id"/> -->
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="sTitulo"/></strong>
                            <div>Fecha: <field name="dFecha"/></div>
                            <!-- <div>Tipo: <field name="tipo_evento_id"/></div> -->
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="action_uprofe_evento" model="ir.actions.act_window">
        <field name="name">Eventos</field>
        <field name="res_model">uprofe.evento</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- MENÚ -->
    <menuitem id="menu_uprofe_evento" 
              name="Eventos" 
              parent="uprofe_menu" 
              action="action_uprofe_evento" 
              sequence="40"/>
</odoo>
