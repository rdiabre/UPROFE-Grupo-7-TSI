<odoo>
    <record id="uprofe_congreso_form_view" model="ir.ui.view">
        <field name="name">uprofe.congreso.form</field>
        <field name="model">uprofe.congreso</field>
        <field name="arch" type="xml">
            <form string="Aportación a congreso">
                <sheet>
                    <group>
                        <group string="Datos de la publicación">
                            <field name="sName"/>
                            <field name="sTitulo"/>
                            <field name="dFecha_publicacion"/>
                        </group>
                        <group string="Datos del congreso">
                            <field name="sNombre_congreso"/>
                            <field name="sLugar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Autores">
                            <group>
                                <field name="profesor_ids" widget="many2many_tags"/>
                                <!--<field name="investigador_ids" widget="many2many_tags"/>-->
                            </group>
                        </page>
                        <page string="Proyecto">
                            <field name="proyecto_investigacion_id"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="uprofe_congreso_list_view" model="ir.ui.view">
        <field name="name">uprofe.congreso.list</field>
        <field name="model">uprofe.congreso</field>
        <field name="arch" type="xml">
            <list string="Aportaciones a congreso">
                <field name="sName"/>
                <field name="sTitulo"/>
                <field name="dFecha_publicacion"/>
                <field name="sNombre_congreso"/>
                <field name="sLugar"/>
            </list>
        </field>
    </record>

    <record id="congreso_list_action" model="ir.actions.act_window">
        <field name="name">Aportaciones a congreso</field>
        <field name="res_model">uprofe.congreso</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Añade la primera aportación a congreso</p>
        </field>
    </record>
</odoo>